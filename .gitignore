# ---------- Unity (client/) ----------
/client/[Ll]ibrary/
/client/[Tt]emp/
/client/[Oo]bj/
/client/[Bb]uild/
/client/[Bb]uilds/
/client/[Ll]ogs/
/client/[Uu]ser[Ss]ettings/
/client/[Mm]emoryCaptures/
/client/[Rr]ecordings/
/client/.utmp/
# Cena de recuperação que o Unity cria quando o editor é fechado à força.
/client/Assets/_Recovery/
/client/Assets/_Recovery.meta
# Recursos de design importados localmente apenas pelo laboratório do editor.
/client/Assets/_Game/Features/LaboratorioVisual/Editor/RecursosGerados/
/client/Assets/_Game/Features/LaboratorioVisual/Editor/RecursosGerados.meta
/client/*.csproj
/client/*.sln
/client/*.slnx
/client/*.unityproj
/client/*.pidb
/client/*.booproj
/client/*.svd
/client/*.pdb
/client/*.mdb
/client/*.opendb
/client/*.VC.db
/client/Assets/Plugins/Editor/JetBrains*
/client/Assets/AssetStoreTools*
/client/crashlytics-build.properties
*.apk
*.aab
*.unitypackage

# ---------- .NET (server/ e shared/) ----------
bin/
obj/
*.user
*.suo
TestResults/
logs/

# ---------- Node (só ferramentas do git: commitlint, husky) ----------
node_modules
# Hooks gerados (husky e git lfs gravam aqui); sem isto, worktrees antigos parecem ter
# mudança não commitada e o npm run limpar-agentes não os remove.
.husky/_/

# ---------- IDEs ----------
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ---------- Assistentes de IA (config pessoal) ----------
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
AGENTS.local.md

# ---------- Logs soltos de verificação (ex.: verificacao.log de agentes) ----------
/*.log

# Prints locais da tela (script de editor; o agente lê e não versiona).
/prints/
client/prints/

# Relatos F9 de sensação (quadros e linha do tempo; a IA lê pelo /relato e não versiona).
/relatos/

# ---------- Sistema ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Banco de dados local (SQLite) ----------
*.db
*.db-shm
*.db-wal

# ---------- Segredos ----------
.env
*.env.local
appsettings.*.local.json

# Endereço do servidor local de cada pessoa (veja ConfiguracaoServidor.cs, #198).
client/servidor.json

# Corpo do PR para o npm run entregar (docs/git.md#entregar).
/pr-corpo.md

