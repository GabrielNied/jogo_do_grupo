{
  "name": "jogo-do-grupo-tooling",
  "private": true,
  "description": "Ferramentas do repo (commitlint, hooks do git, export do FigJam). O jogo é C#; isto não roda no jogo.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "validar-branch": "node scripts/git/validar-branch.mjs",
    "figma:exportar": "node scripts/figma/exportar-brainstorm.mjs",
    "server:rodar": "dotnet run --project server/src/JogoDoGrupo.Server",
    "unity:compilar": "node scripts/unity/compilar-client.mjs",
    "unity:recompilar": "node scripts/unity/unity.mjs recompilar",
    "unity:testes": "node scripts/unity/unity.mjs testes",
    "unity:executar": "node scripts/unity/unity.mjs executar",
    "unity:editor": "node scripts/unity/editor-aberto.mjs",
    "unity:importar": "node scripts/unity/unity.mjs importar",
    "unity:meta": "node scripts/unity/gerar-meta.mjs",
    "testar-scripts": "node --test \"scripts/**/*.test.mjs\"",
    "conferir-unity": "node scripts/git/conferir-arquivos-unity.mjs",
    "entregar": "node scripts/git/entregar.mjs",
    "tarefa": "node scripts/git/tarefas.mjs",
    "limpar-agentes": "node scripts/git/limpar-agentes.mjs",
    "nuvem:preparar": "node scripts/agentes/preparar-nuvem.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7"
  }
}
