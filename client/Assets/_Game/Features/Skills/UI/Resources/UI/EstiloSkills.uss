.skills-barra {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--lumora-espacamento-grande);
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.skill-espaco {
    width: 20%;
    min-width: 96px;
    max-width: 168px;
    margin-left: var(--lumora-espacamento-curto);
    margin-right: var(--lumora-espacamento-curto);
    padding: var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-cartao);
    overflow: hidden;
}

.skill-em-recarga {
    border-color: var(--lumora-cores-borda-discreta);
}

.skill-cobertura {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: var(--lumora-cores-trilho);
    opacity: 0.85;
}

.skill-tecla {
    font-size: var(--lumora-tipografia-controle);
    color: var(--lumora-cores-ouro);
    -unity-text-align: middle-left;
}

.skill-nome {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    white-space: normal;
}

.skill-custo {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-essencia);
}

.skill-recarga {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: var(--lumora-tipografia-titulo);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-center;
}

.skills-vazio {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--lumora-espacamento-grande);
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-borda-discreta);
    -unity-text-align: middle-center;
    white-space: normal;
}

.skills-aviso {
    position: absolute;
    left: 50%;
    bottom: 110px;
    width: var(--lumora-dimensoes-recursos-largura);
    max-width: var(--lumora-dimensoes-dialogo-percentual);
    translate: -50% 0;
    padding: var(--lumora-espacamento-pequeno);
    font-size: var(--lumora-tipografia-controle);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-erro);
    background-color: var(--lumora-cores-painel);
    white-space: normal;
}

.skills-poder {
    position: absolute;
    left: 50%;
    bottom: 150px;
    width: var(--lumora-dimensoes-recursos-largura);
    max-width: var(--lumora-dimensoes-dialogo-percentual);
    translate: -50% 0;
    padding: var(--lumora-espacamento-pequeno);
    font-size: var(--lumora-tipografia-controle);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-ouro);
    background-color: var(--lumora-cores-painel);
    white-space: normal;
}

.skills-numeros {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.skill-dano {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--lumora-dimensoes-dano-largura);
    translate: -50% -100%;
    font-size: var(--lumora-tipografia-titulo);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-essencia);
}

.lumora-estreito .skill-espaco {
    width: 30%;
    min-width: 0;
    margin-left: var(--lumora-espacamento-minimo);
    margin-right: var(--lumora-espacamento-minimo);
}

/* =======================================================
   Janela de Skills (K) - Somente leitura por conjunto/arma
   ======================================================= */

.skills-janela-banner {
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-cartao);
    padding: 8px 12px;
    margin-bottom: var(--lumora-espacamento-curto);
}

.skills-janela-banner-titulo {
    font-size: 12.5px;
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

.skills-janela-banner-sub {
    font-size: 11px;
    color: #9aa5b5;
    margin-top: 2px;
}

.skills-janela-banner-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.skills-janela-chip {
    background-color: rgba(20, 28, 38, 0.9);
    border-width: 1px;
    border-color: var(--lumora-cores-ouro);
    border-radius: 4px;
    padding: 3px 8px;
    margin-right: 6px;
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--lumora-cores-ouro);
}

.skills-janela-seletor-armas {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--lumora-espacamento-curto);
}

.skills-janela-aba-arma {
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 6px 12px;
    border-radius: var(--lumora-bordas-raio-botao);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-botao);
    background-color: var(--lumora-cores-painel);
    color: var(--lumora-cores-marfim);
    font-size: 12px;
}

.skills-janela-aba-arma:hover {
    border-color: var(--lumora-cores-essencia);
}

.skills-janela-aba-arma-selecionada {
    border-color: var(--lumora-cores-ouro);
    background-color: rgba(220, 175, 75, 0.18);
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

.skills-janela-aba-arma-ativa {
    border-color: var(--lumora-cores-essencia);
}

.skills-janela-scroll {
    max-height: 380px;
    min-height: 240px;
}

.skills-janela-cartao {
    background-color: var(--lumora-cores-painel);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-cartao);
    padding: 9px 12px;
    margin-bottom: 7px;
}

.skills-janela-cartao-ativo {
    border-width: 1.5px;
    border-color: var(--lumora-cores-ouro);
    background-color: rgba(30, 42, 54, 0.95);
}

.skills-janela-cartao-cabecalho {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.skills-janela-cartao-nome {
    font-size: 13.5px;
    -unity-font-style: bold;
    color: var(--lumora-cores-marfim);
}

.skills-janela-cartao-badge-ativa {
    background-color: rgba(220, 175, 75, 0.25);
    border-width: 1px;
    border-color: var(--lumora-cores-ouro);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

.skills-janela-cartao-custo {
    font-size: 11.5px;
    -unity-font-style: bold;
}

.skills-janela-cartao-custo-stamina {
    color: #98d05a;
}

.skills-janela-cartao-custo-mana {
    color: #4dc5d8;
}

.skills-janela-cartao-detalhes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
    margin-bottom: 3px;
}

.skills-janela-cartao-detalhe {
    font-size: 11px;
    color: #b0b8c6;
    margin-right: 14px;
}

.skills-janela-cartao-tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.skills-janela-cartao-tag {
    font-size: 9.5px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    padding: 1px 5px;
    margin-right: 4px;
    color: #8e9aab;
}
