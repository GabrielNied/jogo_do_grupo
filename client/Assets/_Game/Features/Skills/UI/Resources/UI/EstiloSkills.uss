/* Barra de ação (embaixo, centro). Os slots usam os componentes do HUD do Core. */
.skills-coluna {
    align-items: center;
}

.skills-barra {
    flex-direction: row;
    align-items: flex-end;
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio) var(--lumora-espacamento-pequeno);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa-acao.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-right: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-top: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-placa);
}

.skills-separador {
    width: 2px;
    height: 40px;
    margin: 0 var(--lumora-espacamento-pequeno) 8px;
    background-color: var(--lumora-cores-borda-discreta);
}

.skills-slot-fixo {
    margin-bottom: 7px;
}

.skills-preparo {
    width: 340px;
    height: 24px;
    margin-bottom: var(--lumora-espacamento-pequeno);
    padding: 3px;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-fundo.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-right: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-top: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-barra);
    justify-content: center;
}

.skills-preparo-barra {
    position: absolute;
    left: 3px;
    top: 3px;
    bottom: 3px;
    width: 0;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-preenchimento.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--lumora-cores-ouro);
}

.skills-preparo-texto {
    font-size: var(--lumora-tipografia-hud-pequeno);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: nowrap;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

.skills-vazio {
    margin-bottom: var(--lumora-espacamento-minimo);
    font-size: var(--lumora-tipografia-hud);
    color: var(--lumora-cores-texto-secundario);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

.skills-aviso {
    margin-bottom: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-fino) var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-controle);
    color: var(--lumora-cores-erro);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px var(--lumora-cores-contorno);
    background-color: var(--lumora-cores-hud-fundo-leve);
    border-radius: var(--lumora-bordas-raio-campo);
}

.skills-poder {
    margin-bottom: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-fino) var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-hud);
    color: var(--lumora-cores-ouro);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px var(--lumora-cores-contorno);
    background-color: var(--lumora-cores-hud-fundo-leve);
    border-radius: var(--lumora-bordas-raio-campo);
}

.skills-numeros {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.skill-dano {
    position: absolute;
    translate: -50% -50%;
    font-size: var(--lumora-tipografia-dano);
    color: var(--lumora-cores-hover-primario);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 2px var(--lumora-cores-contorno);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--lumora-cores-contorno);
}

/* Janela de skills (K). */
.skills-janela-banner {
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-cartao);
    padding: 8px 12px;
    margin-bottom: var(--lumora-espacamento-curto);
}

.skills-janela-banner-titulo {
    font-size: 12.5px;
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

.skills-janela-banner-sub {
    font-size: 11px;
    color: #9aa5b5;
    margin-top: 2px;
}

.skills-janela-banner-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.skills-janela-chip {
    background-color: rgba(20, 28, 38, 0.9);
    border-width: 1px;
    border-color: var(--lumora-cores-ouro);
    border-radius: 4px;
    padding: 3px 8px;
    margin-right: 6px;
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--lumora-cores-ouro);
}

.skills-janela-seletor-armas {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--lumora-espacamento-curto);
}

.skills-janela-aba-arma {
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 6px 12px;
    border-radius: var(--lumora-bordas-raio-botao);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-botao);
    background-color: var(--lumora-cores-painel);
    color: var(--lumora-cores-marfim);
    font-size: 12px;
}

.skills-janela-aba-arma:hover {
    border-color: var(--lumora-cores-essencia);
}

.skills-janela-aba-arma-selecionada {
    border-color: var(--lumora-cores-ouro);
    background-color: rgba(220, 175, 75, 0.18);
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

.skills-janela-aba-arma-ativa {
    border-color: var(--lumora-cores-essencia);
}

.skills-janela-scroll {
    max-height: 380px;
    min-height: 240px;
}

.skills-janela-cartao {
    background-color: var(--lumora-cores-painel);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-cartao);
    padding: 9px 12px;
    margin-bottom: 7px;
}

.skills-janela-cartao-ativo {
    border-width: 1.5px;
    border-color: var(--lumora-cores-ouro);
    background-color: rgba(30, 42, 54, 0.95);
}

.skills-janela-cartao-cabecalho {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.skills-janela-cartao-nome {
    font-size: 13.5px;
    -unity-font-style: bold;
    color: var(--lumora-cores-marfim);
}

.skills-janela-cartao-badge-ativa {
    background-color: rgba(220, 175, 75, 0.25);
    border-width: 1px;
    border-color: var(--lumora-cores-ouro);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

.skills-janela-cartao-custo {
    font-size: 11.5px;
    -unity-font-style: bold;
}

.skills-janela-cartao-custo-stamina {
    color: #98d05a;
}

.skills-janela-cartao-custo-mana {
    color: #4dc5d8;
}

.skills-janela-cartao-detalhes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
    margin-bottom: 3px;
}

.skills-janela-cartao-detalhe {
    font-size: 11px;
    color: #b0b8c6;
    margin-right: 14px;
}

.skills-janela-cartao-tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.skills-janela-cartao-tag {
    font-size: 9.5px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    padding: 1px 5px;
    margin-right: 4px;
    color: #8e9aab;
}
