.inimigos-camada {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inimigo-etiqueta {
    position: absolute;
    width: var(--lumora-dimensoes-inimigo-largura);
    align-items: center;
    translate: -50% -100%;
}

.inimigo-nome {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    -unity-text-outline-width: var(--lumora-bordas-fina);
    -unity-text-outline-color: var(--lumora-cores-trilho);
    white-space: normal;
    -unity-text-align: middle-center;
}

.inimigo-etiqueta-fortalecida .inimigo-nome {
    color: var(--lumora-cores-erro);
}

.inimigo-barra {
    width: var(--lumora-dimensoes-inimigo-barra);
    height: var(--lumora-dimensoes-inimigo-barra-altura);
    margin-top: var(--lumora-espacamento-minimo);
    background-color: var(--lumora-cores-trilho);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    overflow: hidden;
}

.inimigo-preenchimento {
    height: 100%;
    width: 100%;
    background-color: var(--lumora-cores-vida);
}

.inimigo-exposto {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-ganho);
    -unity-text-outline-width: var(--lumora-bordas-fina);
    -unity-text-outline-color: var(--lumora-cores-trilho);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
