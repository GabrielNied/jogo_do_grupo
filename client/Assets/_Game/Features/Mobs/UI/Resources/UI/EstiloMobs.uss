.inimigos-camada {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inimigo-aviso {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --cor-aviso: rgba(220, 50, 40, 0.9);
    --cor-aviso-preenchimento: rgba(220, 50, 40, 0.35);
}

.inimigo-etiqueta {
    position: absolute;
    width: 120px;
    align-items: center;
    translate: -50% -100%;
}

.inimigo-nome {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 232, 214);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(10, 8, 6);
}

.inimigo-etiqueta-fortalecida .inimigo-nome {
    color: rgb(255, 96, 80);
}

.inimigo-barra {
    width: 100px;
    height: 8px;
    margin-top: 2px;
    background-color: rgb(10, 8, 6);
    border-width: 1px;
    border-color: rgb(120, 92, 48);
    overflow: hidden;
}

.inimigo-preenchimento {
    height: 100%;
    width: 100%;
    background-color: rgb(176, 48, 40);
}
