/* Etiquetas sobre a cabeça dos inimigos (nameplates). */
.inimigos-camada {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inimigo-etiqueta {
    position: absolute;
    width: var(--lumora-dimensoes-inimigo-largura);
    align-items: center;
    translate: -50% -100%;
}

.inimigo-nome {
    font-size: var(--lumora-tipografia-hud);
    color: var(--lumora-cores-nome-inimigo);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--lumora-cores-contorno);
    text-shadow: 1px 1px 2px var(--lumora-cores-contorno);
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.inimigo-etiqueta-elite .inimigo-nome {
    color: var(--lumora-cores-raridade-lendaria);
}

.inimigo-etiqueta-alvo .inimigo-barra {
    border-width: 1px;
    border-color: var(--lumora-cores-erro);
}

.inimigo-alerta {
    font-size: var(--lumora-tipografia-hud-titulo);
    color: var(--lumora-cores-erro);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--lumora-cores-contorno);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: -2px;
}

.inimigo-barra {
    width: var(--lumora-dimensoes-inimigo-barra);
    height: 10px;
    margin-top: var(--lumora-espacamento-fino);
    padding: 1px;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-fundo.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-right: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-top: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-barra);
    overflow: hidden;
}

.inimigo-preenchimento {
    height: 100%;
    width: 100%;
    border-radius: 1px;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-preenchimento.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--lumora-cores-vida);
}

.inimigo-exposto {
    font-size: var(--lumora-tipografia-hud-pequeno);
    color: var(--lumora-cores-ganho);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--lumora-cores-contorno);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Quadro do alvo e do chefe (topo, centro). */
.hud-alvo-coluna {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
}

.hud-barra-boss, .hud-barra-alvo {
    align-items: stretch;
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-extra) var(--lumora-espacamento-medio);
    margin-bottom: var(--lumora-espacamento-pequeno);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa-alvo.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 16;
    -unity-slice-bottom: 16;
}

.hud-barra-boss {
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa-alvo-chefe.png");
    padding-top: var(--lumora-espacamento-medio);
}

.hud-alvo-elite {
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa-alvo-elite.png");
}

.hud-alvo-cabecalho {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--lumora-espacamento-minimo);
}

.hud-alvo-caveira {
    width: 22px;
    height: 22px;
    margin-right: var(--lumora-espacamento-pequeno);
    -unity-background-image-tint-color: var(--lumora-cores-erro);
}

.hud-alvo-nome {
    font-size: var(--lumora-tipografia-hud-nome);
    color: var(--lumora-cores-nome-inimigo);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px var(--lumora-cores-contorno);
    white-space: nowrap;
}

.hud-alvo-elite .hud-alvo-nome {
    color: var(--lumora-cores-raridade-lendaria);
}

.hud-barra-boss .hud-alvo-nome {
    font-size: var(--lumora-tipografia-hud-titulo);
    color: var(--lumora-cores-ouro);
}

.hud-alvo-nivel {
    margin-left: var(--lumora-espacamento-pequeno);
    font-size: var(--lumora-tipografia-hud-pequeno);
    color: var(--lumora-cores-texto-secundario);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

.hud-alvo-trilho {
    height: 20px;
}

.hud-barra-boss .hud-alvo-trilho {
    height: 26px;
}

.hud-alvo-percentual {
    position: absolute;
    right: 8px;
    top: 0;
    bottom: 0;
    font-size: var(--lumora-tipografia-hud-pequeno);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

/* Janela do Bestiário. Cores por nível de conhecimento e tons sem token ficam no C#. */
.lumora-ui .bestiario-janela {
    flex-direction: column;
    flex-grow: 1;
}

.lumora-ui .bestiario-barra-superior {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.lumora-ui .bestiario-abas {
    flex-direction: row;
}

.lumora-ui .bestiario-resumo {
    font-size: 12px;
}

.lumora-ui .bestiario-corpo {
    flex-direction: row;
    flex-grow: 1;
}

.lumora-ui .bestiario-lista {
    width: 280px;
    margin-right: 12px;
    border-right-width: 1px;
}

.lumora-ui .bestiario-detalhes {
    flex-grow: 1;
    padding-left: 8px;
}

.lumora-ui .bestiario-ficha {
    flex-grow: 1;
}

.lumora-ui .bestiario-aba {
    margin-right: 6px;
    padding: 4px 12px 4px 12px;
    border-radius: 4px;
    background-color: var(--lumora-cores-desabilitado);
    color: var(--lumora-cores-texto-secundario);
    border-bottom-width: 1px;
}

.lumora-ui .bestiario-aba-ativa {
    background-color: var(--lumora-cores-selecionado);
    border-bottom-width: 2px;
}

/* Item da lista */
.lumora-ui .bestiario-item {
    flex-direction: column;
    padding: 6px 8px 6px 8px;
    margin-bottom: 6px;
    border-left-width: 4px;
    border-radius: 4px;
    background-color: var(--lumora-cores-campo);
}

.lumora-ui .bestiario-item-selecionado {
    background-color: var(--lumora-cores-selecionado);
}

.lumora-ui .bestiario-item-topo {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.lumora-ui .bestiario-item-nome {
    font-size: 13px;
    -unity-font-style: bold;
}

.lumora-ui .bestiario-item-nivel {
    font-size: 10px;
    -unity-font-style: bold;
}

.lumora-ui .bestiario-item-sub {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 3px;
}

.lumora-ui .bestiario-item-texto {
    font-size: 11px;
}

/* Ficha */
.lumora-ui .bestiario-vazio {
    margin-top: 20px;
}

.lumora-ui .bestiario-ficha-topo {
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
}

.lumora-ui .bestiario-ficha-titulo-linha {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.lumora-ui .bestiario-ficha-titulo {
    font-size: 20px;
    -unity-font-style: bold;
}

.lumora-ui .bestiario-ficha-pill {
    font-size: 11px;
    padding: 2px 8px 2px 8px;
    background-color: var(--lumora-cores-retrato);
    border-radius: 4px;
}

.lumora-ui .bestiario-ficha-subtitulo {
    font-size: 12px;
    color: var(--lumora-cores-texto-secundario);
    margin-top: 2px;
}

.lumora-ui .bestiario-progresso {
    margin-bottom: 14px;
}

.lumora-ui .bestiario-progresso-texto {
    font-size: 11px;
    margin-bottom: 3px;
}

.lumora-ui .bestiario-barra-fundo {
    height: 8px;
    background-color: var(--lumora-cores-trilho);
    border-radius: 4px;
}

.lumora-ui .bestiario-barra-preenchimento {
    height: 8px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.lumora-ui .bestiario-frase {
    padding: 10px 14px 10px 14px;
    margin-top: 8px;
    background-color: var(--lumora-cores-campo);
    border-left-width: 3px;
}

.lumora-ui .bestiario-frase-texto {
    font-size: 12px;
    -unity-font-style: italic;
    white-space: normal;
}

.lumora-ui .bestiario-cartao {
    background-color: var(--lumora-cores-campo);
    padding: 8px 10px 8px 10px;
    margin-bottom: 8px;
    border-radius: 4px;
}

.lumora-ui .bestiario-cartao-bloqueado {
    border-left-width: 2px;
}

.lumora-ui .bestiario-cartao-titulo {
    font-size: 12px;
    -unity-font-style: bold;
}

.lumora-ui .bestiario-cartao-titulo-bloqueado {
    font-size: 12px;
}

.lumora-ui .bestiario-cartao-subtitulo {
    font-size: 11px;
    margin-bottom: 4px;
}

.lumora-ui .bestiario-cartao-corpo {
    font-size: 12px;
    white-space: normal;
}

.lumora-ui .bestiario-cartao-dica {
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}
