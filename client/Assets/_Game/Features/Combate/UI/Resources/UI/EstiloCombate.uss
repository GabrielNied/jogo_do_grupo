.recursos {
    width: 100%;
    padding: var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.recursos-soltos {
    position: absolute;
    left: var(--lumora-espacamento-grande);
    top: var(--lumora-espacamento-grande);
    width: var(--lumora-dimensoes-recursos-largura);
    max-width: var(--lumora-dimensoes-dialogo-percentual);
}

.recurso-linha {
    min-height: var(--lumora-dimensoes-barra);
    margin-bottom: var(--lumora-espacamento-curto);
    flex-direction: row;
    align-items: center;
}

.recurso-rotulo {
    width: 24%;
    flex-shrink: 0;
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    white-space: normal;
}

.recurso-barra {
    min-height: var(--lumora-dimensoes-barra);
    min-width: var(--lumora-espacamento-extra);
    margin-left: var(--lumora-espacamento-curto);
    margin-right: var(--lumora-espacamento-curto);
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--lumora-cores-trilho);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-campo);
    overflow: hidden;
}

.recurso-preenchimento {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
}

.barra-vida {
    background-color: var(--lumora-cores-vida);
}

.barra-stamina {
    background-color: var(--lumora-cores-ouro);
}

.barra-mana {
    background-color: var(--lumora-cores-essencia);
}

.recurso-valor {
    width: 25%;
    flex-shrink: 0;
    font-size: var(--lumora-tipografia-leitura);
    -unity-text-align: middle-right;
    color: var(--lumora-cores-marfim);
    white-space: normal;
}

.numeros-de-dano {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dano-numero {
    position: absolute;
    left: 0;
    translate: -50% 0;
    top: 0;
    width: var(--lumora-dimensoes-dano-largura);
    font-size: var(--lumora-tipografia-titulo);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-marfim);
    text-shadow: var(--lumora-bordas-fina) var(--lumora-bordas-fina) var(--lumora-cores-sombra);
}

.dano-pesado {
    font-size: var(--lumora-tipografia-dano-pesado);
    color: var(--lumora-cores-ouro);
}

.vinheta-de-dano {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: var(--lumora-espacamento-grande);
    border-color: var(--lumora-cores-erro);
}

.aviso-de-ataque {
    position: absolute;
    left: 50%;
    top: 58%;
    width: var(--lumora-dimensoes-recursos-largura);
    translate: -50% 0;
    font-size: var(--lumora-tipografia-controle);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-erro);
    background-color: var(--lumora-cores-painel);
    white-space: normal;
}

.lumora-estreito .recursos {
    width: 100%;
}

.lumora-estreito .recursos-soltos {
    left: var(--lumora-espacamento-pequeno);
    top: var(--lumora-espacamento-pequeno);
    width: var(--lumora-dimensoes-ferramentas);
}

.guarda-indicador {
    position: absolute;
    left: 50%;
    top: 52%;
    width: var(--lumora-dimensoes-recursos-largura);
    translate: -50% 0;
    font-size: var(--lumora-tipografia-controle);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-ouro);
    background-color: var(--lumora-cores-painel);
}

.guarda-fraca {
    color: var(--lumora-cores-erro);
}
