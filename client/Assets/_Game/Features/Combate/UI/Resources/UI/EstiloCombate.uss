/* Quadro do personagem (alto à esquerda). */
.recursos {
    flex-direction: row;
    align-items: center;
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio) var(--lumora-espacamento-pequeno) var(--lumora-espacamento-pequeno);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-right: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-top: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-placa);
}

.recursos-soltos {
    position: absolute;
    left: var(--lumora-espacamento-grande);
    top: var(--lumora-espacamento-grande);
    width: var(--lumora-dimensoes-quadro-largura);
}

.recursos-vida-baixa {
    -unity-background-image-tint-color: var(--lumora-cores-erro);
}

.recursos-coluna {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: var(--lumora-espacamento-pequeno);
}

.recursos-nome {
    font-size: var(--lumora-tipografia-hud-nome);
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
    margin-bottom: var(--lumora-espacamento-fino);
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recursos-barra-vida {
    height: 22px;
    margin-bottom: var(--lumora-espacamento-fino);
}

.recursos-barra-mana {
    height: 16px;
    margin-bottom: var(--lumora-espacamento-fino);
}

.recursos-barra-mana .hud-barra-texto {
    font-size: var(--lumora-tipografia-tecla);
}

/* Efeitos de status: ícones sob o quadro. */
.painel-status {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--lumora-espacamento-curto);
    margin-left: var(--lumora-espacamento-pequeno);
}

.item-status-coluna {
    align-items: center;
    margin-right: var(--lumora-espacamento-minimo);
    margin-bottom: var(--lumora-espacamento-minimo);
}

.item-status {
    width: var(--lumora-dimensoes-efeito);
    height: var(--lumora-dimensoes-efeito);
    padding: 3px;
    border-width: 2px;
    border-radius: 3px;
    border-color: var(--lumora-cores-borda-botao);
    background-color: var(--lumora-cores-fundo);
}

.item-status-benefico {
    border-color: var(--lumora-cores-ganho);
}

.item-status-nocivo {
    border-color: var(--lumora-cores-erro);
}

.item-status-icone {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--lumora-cores-marfim);
}

.item-status-acumulos {
    position: absolute;
    right: 1px;
    bottom: -2px;
    font-size: var(--lumora-tipografia-tecla);
    color: var(--lumora-cores-marfim);
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

.status-tempo {
    font-size: var(--lumora-tipografia-tecla);
    color: var(--lumora-cores-marfim);
    -unity-text-align: upper-center;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

/* Números de dano no mundo. */
.numeros-de-dano {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dano-numero {
    position: absolute;
    left: 0;
    translate: -50% 0;
    top: 0;
    width: var(--lumora-dimensoes-dano-largura);
    font-size: var(--lumora-tipografia-dano);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--lumora-cores-marfim);
    text-shadow: 2px 2px 2px var(--lumora-cores-contorno);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--lumora-cores-contorno);
}

.dano-pesado {
    font-size: var(--lumora-tipografia-critico);
    color: var(--lumora-cores-ouro);
}

.vinheta-de-dano {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: var(--lumora-espacamento-grande);
    border-color: var(--lumora-cores-perigo-preenchimento);
}

.aviso-de-ataque {
    position: absolute;
    left: 50%;
    top: 62%;
    translate: -50% 0;
    padding: var(--lumora-espacamento-fino) var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-controle);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--lumora-cores-erro);
    background-color: var(--lumora-cores-hud-fundo-leve);
    border-radius: var(--lumora-bordas-raio-campo);
    text-shadow: 1px 1px 2px var(--lumora-cores-contorno);
    white-space: normal;
}

.guarda-indicador {
    position: absolute;
    left: 50%;
    top: 56%;
    translate: -50% 0;
    padding: var(--lumora-espacamento-fino) var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-hud);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--lumora-cores-ouro);
    background-color: var(--lumora-cores-hud-fundo-leve);
    border-radius: var(--lumora-bordas-raio-campo);
    text-shadow: 1px 1px 2px var(--lumora-cores-contorno);
}

.guarda-fraca {
    color: var(--lumora-cores-erro);
}

/* Barra de quebra (chefe), abaixo da barra de vida do chefe. */
.painel-quebra-boss {
    width: 100%;
    margin-top: var(--lumora-espacamento-minimo);
    align-items: stretch;
}

.quebra-boss-rotulo {
    font-size: var(--lumora-tipografia-tecla);
    color: var(--lumora-cores-texto-secundario);
    -unity-text-align: middle-center;
    margin-bottom: var(--lumora-espacamento-fino);
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
}

.quebra-boss-trilho {
    width: 100%;
    height: var(--lumora-dimensoes-barra-hud-fina);
    padding: 1px;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-fundo.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-right: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-top: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-barra);
    overflow: hidden;
}

.quebra-boss-preenchimento {
    position: absolute;
    left: 1px;
    top: 1px;
    bottom: 1px;
    width: 0;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-preenchimento.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--lumora-cores-ouro);
}

.quebra-boss-vulneravel {
    -unity-background-image-tint-color: var(--lumora-cores-erro);
}

/* Retículo dinâmico de mira (armas de longo alcance). */
.reticulo-mira {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
}

.reticulo-ponto {
    position: absolute;
    width: 4px;
    height: 4px;
    background-color: var(--lumora-cores-ouro);
    border-radius: 2px;
}

.reticulo-marca {
    position: absolute;
    background-color: var(--lumora-cores-ouro);
    opacity: 0.75;
}

.reticulo-marca-topo {
    top: 6px;
    width: 2px;
    height: 8px;
}

.reticulo-marca-baixo {
    bottom: 6px;
    width: 2px;
    height: 8px;
}

.reticulo-marca-esquerda {
    left: 6px;
    width: 8px;
    height: 2px;
}

.reticulo-marca-direita {
    right: 6px;
    width: 8px;
    height: 2px;
}

.reticulo-carregando {
    opacity: 1;
}

.reticulo-pronto {
    opacity: 1;
}
