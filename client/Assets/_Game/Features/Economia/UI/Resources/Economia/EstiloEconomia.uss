/* Janelas de Economia sem folha própria: vendedor, ferreiro, correio e banco da guilda.
   Só tokens do Lumora; cores sem token (saldo, tons de texto) ficam no C#.
   O mercado (leilão e barraca) tem a sua em EstiloMercado.uss. */
.lumora-ui .economia-conteudo {
    padding: 10px 14px 12px 14px;
}

.lumora-ui .economia-conteudo-vendedor {
    min-width: 540px;
    max-width: 640px;
}

.lumora-ui .economia-conteudo-ferreiro {
    min-width: 480px;
    max-width: 560px;
}

.lumora-ui .economia-topo {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lumora-cores-borda-discreta);
}

.lumora-ui .economia-titulo {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--lumora-cores-marfim);
}

.lumora-ui .economia-saldo {
    font-size: 14px;
    -unity-font-style: bold;
}

.lumora-ui .economia-aviso {
    font-size: 11px;
    margin-bottom: 6px;
}

.lumora-ui .economia-descricao {
    font-size: 11.5px;
    color: var(--lumora-cores-texto-secundario);
    margin-bottom: 8px;
}

.lumora-ui .economia-nota {
    font-size: 11px;
    white-space: normal;
}

/* Vendedor */
.lumora-ui .economia-abas {
    flex-direction: row;
    margin-bottom: 10px;
}

.lumora-ui .botao.economia-aba {
    background-color: var(--lumora-cores-desabilitado);
}

.lumora-ui .botao.economia-aba-ativa {
    background-color: var(--lumora-cores-selecionado);
}

.lumora-ui .botao.economia-aba-esquerda {
    margin-right: 6px;
}

.lumora-ui .economia-lista {
    max-height: 280px;
}

.lumora-ui .economia-linha {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px 6px 8px;
    margin-bottom: 4px;
    background-color: var(--lumora-cores-campo);
    border-radius: 4px;
}

.lumora-ui .economia-linha-nome {
    font-size: 12px;
    -unity-font-style: bold;
}

.lumora-ui .economia-linha-direita {
    flex-direction: row;
    align-items: center;
}

.lumora-ui .economia-linha-preco {
    font-size: 11.5px;
    margin-right: 10px;
}

.lumora-ui .botao.economia-linha-acao {
    padding: 4px 12px 4px 12px;
}

.lumora-ui .economia-tabela-precos {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.lumora-ui .economia-selo-tier {
    padding: 4px 8px 4px 8px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: var(--lumora-cores-retrato);
    border-radius: 4px;
}

.lumora-ui .economia-selo-tier-texto {
    font-size: 11px;
    -unity-font-style: bold;
}

.lumora-ui .economia-dica {
    font-size: 10.5px;
}
