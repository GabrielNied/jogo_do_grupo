/* Janelas de Pets (companheiros e cuidador). Cores sem token (selos, tons de texto, borda de pet
   obtido) continuam no C#; as de token vêm daqui. */
.lumora-ui .pets-conteudo {
    min-width: 520px;
    max-width: 640px;
    padding: 10px 14px 12px 14px;
}

.lumora-ui .pets-abas {
    flex-direction: row;
    margin-bottom: 10px;
}

.lumora-ui .botao.pets-aba {
    padding: 6px 16px 6px 16px;
    background-color: var(--lumora-cores-selecionado);
    -unity-font-style: bold;
}

.lumora-ui .pets-subtitulo {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.lumora-ui .pets-descricao {
    font-size: 11.5px;
    color: var(--lumora-cores-texto-secundario);
    margin-bottom: 12px;
}

.lumora-ui .pets-cartoes {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
}

.lumora-ui .pets-rodape {
    font-size: 11px;
    margin-top: 12px;
    color: var(--lumora-cores-texto-desabilitado);
}

/* Cartão de pet */
.lumora-ui .pets-cartao {
    width: 240px;
    min-height: 220px;
    margin-bottom: 10px;
    padding: 10px 12px 10px 12px;
    background-color: var(--lumora-cores-campo);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: 6px;
    flex-direction: column;
    justify-content: space-between;
    opacity: 1;
}

.lumora-ui .pets-cartao-obtido {
    background-color: var(--lumora-cores-selecionado);
}

.lumora-ui .pets-cartao-bloqueado {
    opacity: 0.55;
    background-color: var(--lumora-cores-trilho);
    border-color: var(--lumora-cores-borda-discreta);
}

.lumora-ui .pets-nome {
    font-size: 13.5px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.lumora-ui .pets-desc {
    font-size: 10.5px;
    white-space: normal;
    margin-bottom: 6px;
}

.lumora-ui .pets-selo {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-bottom: 6px;
    border-width: 1px;
    border-radius: 4px;
}

.lumora-ui .pets-selo-bloqueado {
    background-color: var(--lumora-cores-desabilitado);
    border-color: var(--lumora-cores-borda-discreta);
}

.lumora-ui .pets-selo-rotulo {
    font-size: 10.5px;
    -unity-font-style: bold;
}

.lumora-ui .pets-origem {
    font-size: 10px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-font-style: italic;
}

.lumora-ui .botao.pets-acao {
    align-self: stretch;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 11.5px;
    -unity-font-style: bold;
}

.lumora-ui .botao.pets-chamar {
    background-color: var(--lumora-cores-hover);
}

/* Cuidador de pets */
.lumora-ui .pets-conteudo-cuidador {
    max-width: 620px;
}

.lumora-ui .pets-cuidador-topo {
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lumora-cores-borda-discreta);
}

.lumora-ui .pets-cuidador-titulo {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--lumora-cores-marfim);
}

.lumora-ui .pets-cuidador-subtitulo {
    font-size: 12px;
    margin-top: 2px;
}

.lumora-ui .pets-cuidador-lista {
    flex-direction: column;
}

.lumora-ui .pets-oferta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px 8px 12px;
    margin-bottom: 6px;
    background-color: var(--lumora-cores-campo);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: 4px;
}

.lumora-ui .pets-oferta-info {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 12px;
}

.lumora-ui .pets-oferta-linha {
    flex-direction: row;
    align-items: center;
}

.lumora-ui .pets-oferta-nome {
    font-size: 13px;
    -unity-font-style: bold;
}

.lumora-ui .pets-oferta-preco {
    font-size: 11.5px;
    -unity-font-style: bold;
    margin-left: 8px;
}

.lumora-ui .pets-oferta-desc {
    font-size: 11px;
    margin-top: 2px;
}

.lumora-ui .botao.pets-oferta-comprar {
    min-width: 130px;
    height: 30px;
}

.lumora-ui .pets-oferta-comprar-indisponivel {
    opacity: 0.5;
}
