.lumora-lab {
    flex-grow: 1;
    background-color: var(--lumora-cores-petroleo);
    color: var(--lumora-cores-marfim);
    font-size: var(--lumora-tipografia-leitura);
    position: relative;
    -unity-background-scale-mode: stretch-to-fill;
}
.lab-topo { flex-direction: row; align-items: center; padding: var(--lumora-espacamento-medio) var(--lumora-espacamento-grande); background-color: var(--lumora-cores-topo); border-bottom-width: var(--lumora-bordas-destaque); border-bottom-color: var(--lumora-cores-ouro); flex-shrink: 0; }
.lab-apresentacao { flex-grow: 1; margin-left: var(--lumora-espacamento-amplo); }
.lab-ferramentas { width: var(--lumora-dimensoes-ferramentas); margin-left: var(--lumora-espacamento-padrao); }
.lab-titulo { font-size: var(--lumora-tipografia-titulo); color: var(--lumora-cores-ouro); white-space: normal; margin-bottom: var(--lumora-espacamento-pequeno); }
.lab-subtitulo { font-size: var(--lumora-tipografia-subtitulo); color: var(--lumora-cores-ouro); white-space: normal; margin-bottom: var(--lumora-espacamento-medio); }
.lab-suave, .lab-nota { color: var(--lumora-cores-texto-secundario); white-space: normal; margin-bottom: var(--lumora-espacamento-padrao); }
.lab-legenda { color: var(--lumora-cores-ouro); margin-bottom: var(--lumora-espacamento-intermediario); }
.lab-corpo { flex-grow: 1; flex-direction: row; min-height: 0; }
.lab-menu { width: var(--lumora-dimensoes-menu); flex-shrink: 0; padding: var(--lumora-espacamento-grande) var(--lumora-espacamento-medio); background-color: var(--lumora-cores-menu); border-right-width: var(--lumora-bordas-fina); border-right-color: var(--lumora-cores-borda-discreta); }
.lab-nota { margin-top: var(--lumora-espacamento-grande); padding: var(--lumora-espacamento-pequeno); }
.lab-area { flex-grow: 1; flex-direction: row; min-width: 0; }
.lab-tela { flex-grow: 1; min-width: 0; flex-basis: 0; }
.lab-metade { width: 50%; }
.lab-rolagem { flex-grow: 1; }
.lab-conteudo { padding: var(--lumora-espacamento-grande); }
.lab-referencia { width: var(--lumora-dimensoes-prancha-percentual); margin: var(--lumora-espacamento-padrao); background-color: var(--lumora-cores-campo); }
.lab-painel { position: relative; padding: var(--lumora-espacamento-grande); margin-top: var(--lumora-espacamento-intermediario); background-color: var(--lumora-cores-painel); border-width: var(--lumora-bordas-fina); border-color: var(--lumora-cores-ouro); border-radius: var(--lumora-bordas-raio-painel); }
.lab-ornamentado { padding: var(--lumora-ornamentos-topo) var(--lumora-ornamentos-lateral) var(--lumora-ornamentos-base) var(--lumora-ornamentos-lateral); min-height: var(--lumora-dimensoes-painel-social-minimo); }
.lab-moldura { position: absolute; left: var(--lumora-ornamentos-deslocamento); right: var(--lumora-ornamentos-deslocamento); top: var(--lumora-ornamentos-deslocamento); bottom: var(--lumora-ornamentos-deslocamento); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: var(--lumora-ornamentos-fatia-horizontal); -unity-slice-right: var(--lumora-ornamentos-fatia-horizontal); -unity-slice-top: var(--lumora-ornamentos-fatia-vertical); -unity-slice-bottom: var(--lumora-ornamentos-fatia-vertical); }
.lab-leitura { white-space: normal; margin-bottom: var(--lumora-espacamento-medio); }
.lab-linha, .lab-cartoes, .lab-grade { flex-direction: row; flex-wrap: wrap; margin-top: var(--lumora-espacamento-medio); margin-bottom: var(--lumora-espacamento-medio); }
.lab-cartao { flex-grow: 1; flex-basis: var(--lumora-dimensoes-item); min-width: var(--lumora-dimensoes-chat-altura); padding: var(--lumora-espacamento-padrao); margin: var(--lumora-espacamento-curto); background-color: var(--lumora-cores-petroleo); border-width: var(--lumora-bordas-fina); border-color: var(--lumora-cores-verde); border-radius: var(--lumora-bordas-raio-cartao); }
.lab-retrato { width: var(--lumora-dimensoes-retrato); height: var(--lumora-dimensoes-retrato); border-radius: var(--lumora-dimensoes-raio-retrato); background-color: var(--lumora-cores-retrato); border-width: var(--lumora-bordas-destaque); border-color: var(--lumora-cores-ouro); font-size: var(--lumora-tipografia-titulo); -unity-text-align: middle-center; margin-bottom: var(--lumora-espacamento-padrao); }
.lab-amostra { width: var(--lumora-dimensoes-retrato); height: var(--lumora-dimensoes-alvo-minimo); border-width: var(--lumora-bordas-fina); border-color: var(--lumora-cores-borda-amostra); margin-right: var(--lumora-espacamento-medio); border-radius: var(--lumora-bordas-raio-campo); }
.lab-pergaminho { background-color: var(--lumora-cores-marfim); padding: var(--lumora-espacamento-grande); margin: var(--lumora-espacamento-intermediario) 0; color: var(--lumora-cores-petroleo); -unity-background-scale-mode: stretch-to-fill; }
.lab-pergaminho .lab-subtitulo { color: var(--lumora-cores-petroleo); }
.lumora-lab Button { min-height: var(--lumora-dimensoes-alvo-minimo); padding: var(--lumora-espacamento-controle) var(--lumora-espacamento-intermediario); margin: var(--lumora-espacamento-minimo); border-width: var(--lumora-bordas-fina); border-color: var(--lumora-cores-borda-botao); border-radius: var(--lumora-bordas-raio-botao); background-color: var(--lumora-cores-petroleo); color: var(--lumora-cores-marfim); white-space: normal; font-size: var(--lumora-tipografia-controle); }
.lumora-lab Button:hover { background-color: var(--lumora-cores-hover); border-color: var(--lumora-cores-essencia); }
.lumora-lab Button:focus { border-width: var(--lumora-bordas-destaque); border-color: var(--lumora-cores-essencia); }
.lumora-lab Button:active { background-color: var(--lumora-cores-pressionado); }
.lumora-lab Button:disabled { background-color: var(--lumora-cores-desabilitado); color: var(--lumora-cores-texto-desabilitado); border-color: var(--lumora-cores-borda-desabilitado); opacity: 0.65; }
.lumora-lab .lab-primario { background-color: var(--lumora-cores-ouro); color: var(--lumora-cores-petroleo); border-color: var(--lumora-cores-borda-primario); }
.lumora-lab .lab-primario:hover { background-color: var(--lumora-cores-hover-primario); color: var(--lumora-cores-petroleo); }
.lumora-lab .lab-selecionado { background-color: var(--lumora-cores-selecionado); border-left-width: var(--lumora-bordas-selecao); border-left-color: var(--lumora-cores-essencia); }
.lumora-lab .lab-aba { -unity-text-align: middle-left; margin-bottom: var(--lumora-espacamento-controle); }
.lumora-lab .lab-item { width: var(--lumora-dimensoes-item); min-height: var(--lumora-dimensoes-item-altura); border-color: var(--lumora-cores-essencia); }
.lumora-lab .lab-atalho { width: var(--lumora-dimensoes-atalho); min-height: var(--lumora-dimensoes-atalho-altura); border-color: var(--lumora-cores-essencia); }
.lumora-lab TextField, .lumora-lab Toggle, .lumora-lab Slider { margin: var(--lumora-espacamento-controle) var(--lumora-espacamento-minimo); min-height: var(--lumora-espacamento-extra); }
.lumora-lab .unity-base-field__label { color: var(--lumora-cores-marfim); min-width: var(--lumora-dimensoes-campo-rotulo); white-space: normal; }
.lumora-lab .unity-text-field__input { background-color: var(--lumora-cores-campo); color: var(--lumora-cores-marfim); border-width: var(--lumora-bordas-fina); border-color: var(--lumora-cores-borda-campo); padding: var(--lumora-espacamento-pequeno); min-height: var(--lumora-dimensoes-campo); }
.lumora-lab .unity-text-field__input:focus { border-color: var(--lumora-cores-essencia); border-width: var(--lumora-bordas-destaque); }
.lumora-lab .lab-erro .unity-text-field__input { border-color: var(--lumora-cores-erro); border-width: var(--lumora-bordas-destaque); }
.lab-barra { margin: var(--lumora-espacamento-medio) var(--lumora-espacamento-minimo); height: var(--lumora-dimensoes-barra); }
.lumora-lab .unity-progress-bar__background { background-color: var(--lumora-cores-trilho); border-width: var(--lumora-bordas-fina); border-color: var(--lumora-cores-borda-campo); border-radius: var(--lumora-bordas-raio-campo); }
.lumora-lab .unity-progress-bar__progress { background-color: var(--lumora-cores-essencia); }
.lumora-lab .unity-progress-bar__title { display: none; }
.lab-veu { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--lumora-cores-veu); align-items: center; justify-content: center; }
.lab-dialogo { width: var(--lumora-dimensoes-dialogo); max-width: var(--lumora-dimensoes-dialogo-percentual); background-color: var(--lumora-cores-petroleo); border-width: var(--lumora-bordas-destaque); border-color: var(--lumora-cores-ouro); border-radius: var(--lumora-bordas-raio-painel); padding: var(--lumora-espacamento-extra); }
.lab-status { flex-shrink: 0; background-color: var(--lumora-cores-campo); color: var(--lumora-cores-marfim); padding: var(--lumora-espacamento-medio) var(--lumora-espacamento-grande); min-height: var(--lumora-dimensoes-status); white-space: normal; }

/* A largura vem do GeometryChangedEvent; não depende de media queries CSS. */
.lumora-ui.lumora-compacto .lab-topo { flex-wrap: wrap; }
.lumora-ui.lumora-compacto .lab-ferramentas { flex-grow: 1; }
.lumora-ui.lumora-compacto .lab-menu { width: var(--lumora-dimensoes-cartao-minimo); }
.lumora-ui.lumora-compacto .lab-area { flex-direction: column; }
.lumora-ui.lumora-compacto .lab-referencia { width: auto; height: var(--lumora-dimensoes-comparacao-altura); flex-shrink: 0; }
.lumora-ui.lumora-compacto .lab-tela { width: auto; }
.lumora-ui.lumora-estreito .lab-corpo { flex-direction: column; }
.lumora-ui.lumora-estreito .lab-menu { width: auto; max-height: var(--lumora-dimensoes-menu-estreito-altura); }
