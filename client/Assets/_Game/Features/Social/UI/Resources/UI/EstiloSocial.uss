/* Chat (embaixo à esquerda), como o do World of Warcraft: abas, fundo translúcido e linhas com
   sombra; esmaece sem atividade. */
.chat {
    width: 100%;
    max-width: 100%;
    min-width: 0;
}

.chat-painel {
    transition-property: opacity;
    transition-duration: 0.4s;
}

.chat-esmaecido {
    opacity: 0.35;
}

.chat-cabecalho {
    flex-direction: row;
    align-items: flex-end;
    padding: 0 var(--lumora-espacamento-minimo);
}

.chat-aba {
    min-height: 26px;
    height: 26px;
    padding: 0 var(--lumora-espacamento-pequeno);
    margin: 0 2px 0 0;
    font-size: var(--lumora-tipografia-hud-pequeno);
    color: var(--lumora-cores-texto-secundario);
    background-color: var(--lumora-cores-transparente);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/aba.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-aba);
    -unity-slice-right: var(--lumora-ornamentos-fatia-aba);
    -unity-slice-top: var(--lumora-ornamentos-fatia-aba);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-aba);
    border-width: 0;
    opacity: 0.8;
}

.chat-aba:hover {
    color: var(--lumora-cores-marfim);
    opacity: 1;
}

.chat-aba-ativa {
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/aba-ativa.png");
    color: var(--lumora-cores-ouro);
    opacity: 1;
}

.chat-espaco {
    flex-grow: 1;
}

.chat-filtro {
    display: none;
}

.chat-ocultar, .chat-ir-ao-fim {
    width: 26px;
    height: 26px;
    min-height: 26px;
    padding: 0;
    margin: 0;
    font-size: var(--lumora-tipografia-hud);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-texto-secundario);
    background-color: var(--lumora-cores-hud-fundo-leve);
    border-width: 1px;
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: 3px;
}

.chat-ocultar:hover, .chat-ir-ao-fim:hover {
    color: var(--lumora-cores-ouro);
    border-color: var(--lumora-cores-ouro);
}

.chat-opcoes {
    flex-direction: row;
    align-items: center;
    padding: 2px var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-chat-fundo);
}

.chat-opcoes > Toggle {
    color: var(--lumora-cores-texto-secundario);
    margin-right: var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-hud-pequeno);
}

.chat-opcoes .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
}

.chat-opcoes .unity-label {
    font-size: var(--lumora-tipografia-hud-pequeno);
    min-width: 0;
    margin-right: var(--lumora-espacamento-minimo);
    color: var(--lumora-cores-texto-secundario);
}

.chat-linhas {
    height: var(--lumora-dimensoes-chat-altura);
    min-height: 0;
    padding: var(--lumora-espacamento-minimo) var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-chat-fundo);
    border-width: 0;
    border-top-width: 1px;
    border-color: var(--lumora-cores-borda-discreta);
}

.chat-linha {
    font-size: var(--lumora-tipografia-hud);
    white-space: normal;
    color: var(--lumora-cores-marfim);
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
    margin: 0;
    padding: 1px 0;
}

.chat-cidade {
    color: var(--lumora-cores-marfim);
}

.chat-grupo {
    color: var(--lumora-cores-nome-jogador);
}

.chat-sussurro {
    color: var(--lumora-cores-sussurro);
}

.chat-sistema {
    color: var(--lumora-cores-aviso);
}

.chat-campo {
    margin: var(--lumora-espacamento-minimo) 0 0;
}

.chat-abrir {
    align-self: flex-start;
    min-height: 30px;
    padding: 2px var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-hud-pequeno);
}

.chat-ir-ao-fim {
    position: absolute;
    right: 14px;
    bottom: 50px;
}

.chat-vazio {
    color: var(--lumora-cores-texto-secundario);
    font-size: var(--lumora-tipografia-hud-pequeno);
    -unity-font-style: italic;
}

.lumora-estreito .chat-aba {
    padding: 0 var(--lumora-espacamento-minimo);
}
