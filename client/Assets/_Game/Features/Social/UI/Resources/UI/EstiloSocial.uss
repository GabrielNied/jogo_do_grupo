/* Chat: mantém o comportamento de esmaecer, com a tipografia Lumora. */
.chat {
    width: var(--lumora-dimensoes-chat-largura);
    max-width: 100%;
    margin-bottom: var(--lumora-dimensoes-dica-base);
    transition-property: opacity;
    transition-duration: 0.4s;
}

.chat-esmaecido {
    opacity: 0.3;
}

.chat-linhas {
    padding: var(--lumora-espacamento-curto) var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.chat-linha {
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    color: var(--lumora-cores-marfim);
}

.chat-cidade {
    color: var(--lumora-cores-marfim);
}

.chat-grupo {
    color: var(--lumora-cores-essencia);
}

.chat-sussurro {
    color: var(--lumora-cores-sussurro);
}

.chat-sistema {
    color: var(--lumora-cores-ouro);
}

.chat-campo {
    margin: var(--lumora-espacamento-minimo) 0 0;
}
