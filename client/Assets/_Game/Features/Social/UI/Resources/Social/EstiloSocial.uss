/* Lumora social: legibilidade, quebra e ações de grupo. */
.social-convidar {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.social-convidar > .campo {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 0;
    margin-right: var(--lumora-espacamento-pequeno);
}

.social-convidar > .botao {
    flex-grow: 0;
    min-width: var(--lumora-dimensoes-social-convidar);
    margin-top: 0;
}

.social-secao {
    margin-bottom: var(--lumora-espacamento-medio);
}

.social-linha {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.social-nome {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.social-lider {
    color: var(--lumora-cores-ouro);
}

.social-offline {
    color: var(--lumora-cores-texto-secundario);
}

.social-acoes {
    flex-direction: row;
    flex-wrap: wrap;
}

.social-botao {
    flex-grow: 0;
    min-height: var(--lumora-dimensoes-alvo-minimo);
    min-width: var(--lumora-dimensoes-social-acao);
    margin-top: 0;
    margin-left: var(--lumora-espacamento-curto);
    font-size: var(--lumora-tipografia-controle);
}

.social-rodape {
    margin-top: var(--lumora-espacamento-pequeno);
}

.social-aviso-tela {
    bottom: var(--lumora-dimensoes-social-aviso-base);
    font-size: var(--lumora-tipografia-subtitulo);
}

.social-convite-tela {
    position: absolute;
    right: var(--lumora-espacamento-padrao);
    bottom: 35%;
    width: var(--lumora-dimensoes-chat-largura);
    max-width: 92%;
    padding: var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.social-convite-tela .linha-botoes {
    flex-direction: row;
    flex-wrap: wrap;
}

.social-convite-tela .botao {
    flex-grow: 1;
    min-width: var(--lumora-dimensoes-social-acao);
}

.lumora-estreito .social-convidar {
    flex-direction: column;
    align-items: stretch;
}

.lumora-estreito .social-convidar > .campo {
    margin-right: 0;
}

.lumora-estreito .social-acoes {
    width: 100%;
    margin-top: var(--lumora-espacamento-pequeno);
}

/* Lista de aliados no HUD (lateral esquerda) */
.lista-grupo-hud {
    width: 200px;
    max-width: 100%;
}

.linha-aliado-hud {
    padding: var(--lumora-espacamento-curto);
    margin-bottom: var(--lumora-espacamento-curto);
    background-color: var(--lumora-cores-painel);
    border-radius: var(--lumora-bordas-raio-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
}

.linha-aliado-topo {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.aliado-nome {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.aliado-lider {
    color: var(--lumora-cores-ouro);
    font-size: var(--lumora-tipografia-controle);
    margin-left: var(--lumora-espacamento-curto);
}

.aliado-status {
    color: var(--lumora-cores-texto-secundario);
    font-size: var(--lumora-tipografia-nota);
    margin-left: var(--lumora-espacamento-curto);
}

.barra-vida-fundo {
    width: 100%;
    height: 16px;
    background-color: var(--lumora-cores-trilho);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    border-radius: var(--lumora-bordas-raio-campo);
    overflow: hidden;
    justify-content: center;
}

.barra-vida-preenchimento {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--lumora-cores-vida);
}

.aliado-vida-texto {
    font-size: var(--lumora-tipografia-nota);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-center;
    width: 100%;
}

.linha-aliado-hud.aliado-offline {
    opacity: 0.5;
}

.linha-aliado-hud.aliado-longe {
    opacity: 0.5;
}

.linha-aliado-hud.aliado-offline .barra-vida-preenchimento {
    background-color: var(--lumora-cores-trilho);
}

.linha-aliado-hud.vida-critica {
    border-left-width: 3px;
    border-left-color: var(--lumora-cores-erro);
}

.barra-vida-fundo.vida-critica {
    border-color: var(--lumora-cores-erro);
}

.barra-vida-preenchimento.vida-critica {
    background-color: var(--lumora-cores-erro);
}

/* Balões de fala no mundo (Speech Bubbles) */
.social-balao-camada {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.social-balao-fala {
    position: absolute;
    min-width: 60px;
    max-width: 280px;
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    border-radius: var(--lumora-bordas-raio-cartao);
    padding: var(--lumora-espacamento-curto) var(--lumora-espacamento-pequeno);
    align-items: center;
    justify-content: center;
    translate: -50% -100%;
}

.social-balao-autor {
    font-size: var(--lumora-tipografia-nota);
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.social-balao-texto {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.social-balao-ponta {
    position: absolute;
    bottom: -6px;
    width: 10px;
    height: 6px;
    background-color: var(--lumora-cores-painel);
    border-bottom-width: var(--lumora-bordas-fina);
    border-right-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    rotate: 45deg;
}

