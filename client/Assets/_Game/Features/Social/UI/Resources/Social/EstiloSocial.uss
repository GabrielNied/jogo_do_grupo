/* Lumora social: legibilidade, quebra e ações de grupo. */
.social-convidar {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.social-convidar > .campo {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 0;
    margin-right: var(--lumora-espacamento-pequeno);
}

.social-convidar > .botao {
    flex-grow: 0;
    min-width: var(--lumora-dimensoes-social-convidar);
    margin-top: 0;
}

.social-secao {
    margin-bottom: var(--lumora-espacamento-medio);
}

.social-linha {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.social-nome {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.social-lider {
    color: var(--lumora-cores-ouro);
}

.social-offline {
    color: var(--lumora-cores-texto-secundario);
}

.social-acoes {
    flex-direction: row;
    flex-wrap: wrap;
}

.social-botao {
    flex-grow: 0;
    min-height: var(--lumora-dimensoes-alvo-minimo);
    min-width: var(--lumora-dimensoes-social-acao);
    margin-top: 0;
    margin-left: var(--lumora-espacamento-curto);
    font-size: var(--lumora-tipografia-controle);
}

.social-rodape {
    margin-top: var(--lumora-espacamento-pequeno);
}

.social-aviso-tela {
    bottom: var(--lumora-dimensoes-social-aviso-base);
    font-size: var(--lumora-tipografia-subtitulo);
}

.social-convite-tela {
    position: absolute;
    right: var(--lumora-espacamento-padrao);
    bottom: 35%;
    width: var(--lumora-dimensoes-chat-largura);
    max-width: 92%;
    padding: var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.social-convite-tela .linha-botoes {
    flex-direction: row;
    flex-wrap: wrap;
}

.social-convite-tela .botao {
    flex-grow: 1;
    min-width: var(--lumora-dimensoes-social-acao);
}

.lumora-estreito .social-convidar {
    flex-direction: column;
    align-items: stretch;
}

.lumora-estreito .social-convidar > .campo {
    margin-right: 0;
}

.lumora-estreito .social-acoes {
    width: 100%;
    margin-top: var(--lumora-espacamento-pequeno);
}

/* Lista de aliados no HUD (lateral esquerda) */
.lista-grupo-hud {
    width: 100%;
    max-width: 100%;
}

/* Quadro de aliado (como os party frames do World of Warcraft). */
.linha-aliado-hud {
    padding: var(--lumora-espacamento-curto) var(--lumora-espacamento-pequeno);
    margin-bottom: var(--lumora-espacamento-minimo);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-right: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-top: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-placa);
}

.linha-aliado-hud:hover {
    -unity-background-image-tint-color: var(--lumora-cores-hover-primario);
}

.linha-aliado-topo {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.aliado-nome {
    font-size: var(--lumora-tipografia-hud);
    color: var(--lumora-cores-nome-jogador);
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.aliado-lider {
    color: var(--lumora-cores-ouro);
    font-size: var(--lumora-tipografia-hud);
    margin-left: var(--lumora-espacamento-curto);
}

.aliado-status {
    color: var(--lumora-cores-texto-secundario);
    font-size: var(--lumora-tipografia-tecla);
    margin-left: var(--lumora-espacamento-curto);
}

.barra-vida-fundo {
    width: 100%;
    height: 18px;
    padding: 2px;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-fundo.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-right: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-top: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-barra);
    overflow: hidden;
    justify-content: center;
}

.barra-vida-preenchimento {
    position: absolute;
    left: 2px;
    top: 2px;
    bottom: 2px;
    width: 0;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-preenchimento.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--lumora-cores-nome-amigo);
}

.aliado-vida-texto {
    font-size: var(--lumora-tipografia-tecla);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
    width: 100%;
}

.linha-aliado-hud.aliado-offline {
    opacity: 0.5;
}

.linha-aliado-hud.aliado-longe {
    opacity: 0.6;
}

.linha-aliado-hud.aliado-offline .barra-vida-preenchimento {
    -unity-background-image-tint-color: var(--lumora-cores-texto-desabilitado);
}

.linha-aliado-hud.vida-critica {
    -unity-background-image-tint-color: var(--lumora-cores-erro);
}

.barra-vida-preenchimento.vida-critica {
    -unity-background-image-tint-color: var(--lumora-cores-vida-baixa);
}

/* Fila de Dungeon (LFG) */
.botao.selecionado {
    background-color: var(--lumora-cores-ouro);
    color: var(--lumora-cores-fundo);
    -unity-font-style: bold;
    border-color: var(--lumora-cores-ouro);
}
/* Marcadores Táticos de Grupo */
.social-marcador-camada {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

/* Balões de fala no mundo (Speech Bubbles) */
.social-balao-camada {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

.social-marcador-tatico {
    position: absolute;
    translate: -50% -100%;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    align-items: center;
    justify-content: center;
    font-size: var(--lumora-tipografia-leitura);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.marcador-caveira {
    border-color: var(--lumora-cores-erro);
    color: var(--lumora-cores-erro);
}

.marcador-cruz {
    border-color: var(--lumora-cores-essencia);
    color: var(--lumora-cores-essencia);
}

.marcador-escudo {
    border-color: var(--lumora-cores-ouro);
    color: var(--lumora-cores-ouro);
}

.marcador-lua {
    border-color: var(--lumora-cores-sussurro);
    color: var(--lumora-cores-sussurro);
}

.marcador-estrela {
    border-color: var(--lumora-cores-aviso);
    color: var(--lumora-cores-aviso);
 }   
.social-balao-fala {
    position: absolute;
    min-width: 60px;
    max-width: 280px;
    background-color: var(--lumora-cores-painel);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    border-radius: var(--lumora-bordas-raio-cartao);
    padding: var(--lumora-espacamento-curto) var(--lumora-espacamento-pequeno);
    align-items: center;
    justify-content: center;
    translate: -50% -100%;
}

.social-balao-autor {
    font-size: var(--lumora-tipografia-nota);
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.social-balao-texto {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.social-balao-ponta {
    position: absolute;
    bottom: -6px;
    width: 10px;
    height: 6px;
    background-color: var(--lumora-cores-painel);
    border-bottom-width: var(--lumora-bordas-fina);
    border-right-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    rotate: 45deg;
}

/* Troca direta (#175) */
.social-troca-colunas {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--lumora-espacamento-medio);
}

.social-troca-lado {
    flex-grow: 1;
    flex-basis: 0;
    min-width: var(--lumora-dimensoes-chat-largura);
    margin-right: var(--lumora-espacamento-pequeno);
    margin-bottom: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-pequeno);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.social-troca-bolsa {
    max-height: var(--lumora-dimensoes-chat-largura);
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.social-troca-item {
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin-top: 0;
    margin-bottom: var(--lumora-espacamento-curto);
    -unity-text-align: middle-left;
    white-space: normal;
}

.social-troca-item-oferecido {
    color: var(--lumora-cores-texto-secundario);
}

.social-convite-troca {
    bottom: 50%;
}

/* Indicador no HUD da fila de Dungeon Finder (perto do minimapa) */
.social-fila-hud {
    flex-direction: row;
    align-items: center;
    background-color: var(--lumora-cores-hud-fundo);
    border-width: 1px;
    border-color: var(--lumora-cores-ouro);
    border-radius: 16px;
    padding: 3px 8px;
    margin-bottom: var(--lumora-espacamento-curto);
    cursor: link;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.social-fila-hud:hover {
    background-color: var(--lumora-cores-hover);
    border-color: var(--lumora-cores-hover-primario);
}

.social-fila-hud-corpo {
    flex-direction: row;
    align-items: center;
    cursor: link;
}

.social-fila-hud-icone {
    font-size: 16px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    width: 20px;
    height: 20px;
}

.social-fila-hud-tempo {
    color: var(--lumora-cores-ouro);
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 8px;
    -unity-text-align: middle-left;
}

.social-fila-hud-cancelar {
    min-width: 18px;
    min-height: 18px;
    width: 18px;
    height: 18px;
    padding: 0;
    margin: 0;
    border-width: 0;
    border-radius: 9px;
    background-color: rgba(184, 50, 42, 0.6);
    color: var(--lumora-cores-marfim);
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    cursor: link;
}

.social-fila-hud-cancelar:hover {
    background-color: var(--lumora-cores-vida);
    color: #ffffff;
}

