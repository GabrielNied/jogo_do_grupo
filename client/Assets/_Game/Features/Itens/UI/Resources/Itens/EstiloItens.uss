/* Inventário em grade (Lumora UI v1). Cores e tamanhos vêm dos tokens --lumora-*; aqui só layout. */

/* A janela do Core é a "painel-largo" (720); a grade pede um pouco mais. */
.janela.itens-painel-largo {
    width: 92%;
    max-width: 1280px;
}

.itens-corpo {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
}

.itens-coluna {
    margin: var(--lumora-espacamento-pequeno);
    min-width: 0;
    flex-shrink: 0;
}

.itens-cabecalho-secao {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.itens-titulo-secao {
    color: var(--lumora-cores-ouro);
    font-size: var(--lumora-tipografia-subtitulo);
    white-space: normal;
}

.itens-contador {
    color: var(--lumora-cores-texto-secundario);
}

.itens-contador-cheio {
    color: var(--lumora-cores-ouro);
    -unity-font-style: bold;
}

/* ---- casa e encaixe ---- */

.item-slot {
    width: 64px;
    height: 64px;
    margin: 2px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--lumora-cores-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-campo);
}

.item-slot:hover {
    border-color: var(--lumora-cores-essencia);
}

.item-slot.item-slot-valido {
    border-color: var(--lumora-cores-essencia);
    border-width: var(--lumora-bordas-destaque);
    background-color: var(--lumora-cores-selecionado);
}

.item-slot.item-slot-invalido {
    border-color: var(--lumora-cores-erro);
    border-width: var(--lumora-bordas-destaque);
    background-color: var(--lumora-cores-perigo-preenchimento);
}

.item-slot.item-slot-alvo {
    border-color: var(--lumora-cores-ouro);
    border-width: var(--lumora-bordas-destaque);
}

.item-slot.item-slot-pendente {
    opacity: 0.45;
}

.item-icone {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 10%;
    bottom: 10%;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

/* Ícone sem tier (item sem dados de equipamento): marfim. */
.item-slot .item-icone { -unity-background-image-tint-color: var(--lumora-cores-marfim); }

.item-slot-vazio .item-icone { -unity-background-image-tint-color: var(--lumora-cores-borda-discreta); }

.item-sigla {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Encaixe vazio: a silhueta (sigla do tipo) fica apagada. */
.item-slot-vazio .item-sigla {
    color: var(--lumora-cores-borda-discreta);
}

/* Tier (D, C, B, A, S, S+): a cor da borda, do ícone e da letra do canto da casa. */
.item-tier-0 { border-color: var(--lumora-cores-texto-secundario); }
.item-tier-1 { border-color: var(--lumora-cores-ganho); }
.item-tier-2 { border-color: var(--lumora-cores-essencia); }
.item-tier-3 { border-color: var(--lumora-cores-sussurro); }
.item-tier-4 { border-color: var(--lumora-cores-ouro); }
.item-tier-5 { border-color: var(--lumora-cores-hover-primario); border-width: var(--lumora-bordas-destaque); }

.item-tier-0 .item-icone { -unity-background-image-tint-color: var(--lumora-cores-texto-secundario); }
.item-tier-1 .item-icone { -unity-background-image-tint-color: var(--lumora-cores-ganho); }
.item-tier-2 .item-icone { -unity-background-image-tint-color: var(--lumora-cores-essencia); }
.item-tier-3 .item-icone { -unity-background-image-tint-color: var(--lumora-cores-sussurro); }
.item-tier-4 .item-icone { -unity-background-image-tint-color: var(--lumora-cores-ouro); }
.item-tier-5 .item-icone { -unity-background-image-tint-color: var(--lumora-cores-hover-primario); }

.item-tier-letra {
    position: absolute;
    right: 2px;
    bottom: 0;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.item-tier-0 .item-tier-letra { color: var(--lumora-cores-texto-secundario); }
.item-tier-1 .item-tier-letra { color: var(--lumora-cores-ganho); }
.item-tier-2 .item-tier-letra { color: var(--lumora-cores-essencia); }
.item-tier-3 .item-tier-letra { color: var(--lumora-cores-sussurro); }
.item-tier-4 .item-tier-letra { color: var(--lumora-cores-ouro); }
.item-tier-5 .item-tier-letra { color: var(--lumora-cores-hover-primario); }

.item-selo-novo {
    position: absolute;
    right: 0;
    top: 0;
    padding: 0 3px;
    font-size: 11px;
    color: var(--lumora-cores-petroleo);
    background-color: var(--lumora-cores-ouro);
    border-radius: var(--lumora-bordas-raio-campo);
}

/* ---- bolsa ---- */

.itens-abas {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--lumora-espacamento-minimo);
}

.itens-aba {
    min-height: 32px;
    margin: 0 var(--lumora-espacamento-minimo) 0 0;
    padding: 0 var(--lumora-espacamento-medio);
}

.itens-aba-ativa {
    background-color: var(--lumora-cores-selecionado);
    border-color: var(--lumora-cores-essencia);
}

/* Largura e altura da grade vêm do PainelInventario (casa calculada pelo espaço da tela). */
.itens-grade {
    width: 292px;
    max-height: 200px;
    flex-direction: column;
}

.itens-grade .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

/* ---- paperdoll ---- */

.itens-paperdoll {
    min-width: 0;
    align-items: center;
}

.itens-paperdoll-linha {
    flex-direction: row;
}

.itens-paperdoll-vazio {
    width: 64px;
    height: 64px;
    margin: 2px;
}

.itens-conjuntos {
    margin-top: var(--lumora-espacamento-pequeno);
    align-items: flex-start;
}

.itens-conjunto {
    flex-direction: row;
    align-items: center;
}

.itens-conjunto-rotulo {
    min-width: 84px;
    min-height: 32px;
    margin: 2px;
    padding: 0 var(--lumora-espacamento-pequeno);
    flex-shrink: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* ---- resumo, avisos e confirmação ---- */

.itens-resumo {
    margin-top: var(--lumora-espacamento-pequeno);
    align-self: stretch;
    min-width: 0;
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-campo);
    border-radius: var(--lumora-bordas-raio-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
}

.itens-resumo-titulo {
    color: var(--lumora-cores-texto-secundario);
    white-space: normal;
}

.itens-resumo-linha {
    flex-direction: row;
    flex-wrap: wrap;
}

.itens-resumo-bonus {
    flex-grow: 1;
    flex-basis: 150px;
    max-width: 240px;
    margin-right: var(--lumora-espacamento-medio);
    white-space: normal;
}

.itens-confirmacao {
    margin-top: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-pequeno);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-erro);
    border-radius: var(--lumora-bordas-raio-campo);
    background-color: var(--lumora-cores-perigo-preenchimento);
}

/* Rodapé compacto: botões com altura de botão normal, sem crescer para preencher a linha. */
.itens-rodape-botoes {
    margin-top: var(--lumora-espacamento-pequeno);
    align-items: center;
}

.lumora-ui .itens-rodape-botoes .botao {
    flex-grow: 0;
    min-height: 32px;
    padding: var(--lumora-espacamento-minimo) var(--lumora-espacamento-medio);
}

.itens-rodape-botoes .unity-base-field {
    margin: var(--lumora-espacamento-minimo);
    flex-grow: 0;
}

/* ---- arraste e tooltip (filhos da raiz da interface) ---- */

.item-fantasma {
    position: absolute;
    width: 64px;
    height: 64px;
    opacity: 0.85;
    picking-mode: ignore;
}

.item-tooltip {
    position: absolute;
    width: 340px;
    padding: var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-topo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-ouro);
    border-radius: var(--lumora-bordas-raio-painel);
    picking-mode: ignore;
}

.item-tooltip-nome {
    font-size: var(--lumora-tipografia-controle);
    white-space: normal;
}

.item-nome-tier-0 { color: var(--lumora-cores-texto-secundario); }
.item-nome-tier-1 { color: var(--lumora-cores-ganho); }
.item-nome-tier-2 { color: var(--lumora-cores-essencia); }
.item-nome-tier-3 { color: var(--lumora-cores-sussurro); }
.item-nome-tier-4 { color: var(--lumora-cores-ouro); }
.item-nome-tier-5 { color: var(--lumora-cores-hover-primario); }

.item-tooltip-linha {
    white-space: normal;
    color: var(--lumora-cores-marfim);
}

.item-tooltip-suave { color: var(--lumora-cores-texto-secundario); }
.item-tooltip-fixo { color: var(--lumora-cores-marfim); }
.item-tooltip-sorteado { color: var(--lumora-cores-essencia); }
.item-tooltip-infusivel { color: var(--lumora-cores-ouro); }
.item-tooltip-ganho { color: var(--lumora-cores-ganho); }
.item-tooltip-perda { color: var(--lumora-cores-erro); }

.item-tooltip-comparacao {
    margin-top: var(--lumora-espacamento-pequeno);
    padding-top: var(--lumora-espacamento-pequeno);
    border-top-width: var(--lumora-bordas-fina);
    border-top-color: var(--lumora-cores-borda-discreta);
}
