/* Seleção e criação em tela cheia, como as do World of Warcraft: o personagem grande no
   centro, painéis com moldura nas laterais e a ação principal embaixo. */
.personagem-tela {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.personagem-tela > .titulo {
    position: absolute;
    left: 0;
    right: 0;
    top: 34px;
    font-size: 40px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 4px var(--lumora-cores-contorno);
}

.personagem-tela > .subtitulo {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    font-size: var(--lumora-tipografia-controle);
    color: var(--lumora-cores-texto-secundario);
    -unity-text-align: middle-center;
}

.personagem-tela > .mensagem {
    position: absolute;
    left: 30%;
    right: 30%;
    top: 46%;
}

.personagem-painel-selecao {
    width: var(--lumora-dimensoes-painel-largo);
}

/* Corpo da seleção: as três partes ficam soltas na tela. */
.personagem-selecao-corpo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.personagem-selecao-vagas {
    position: absolute;
    right: 48px;
    top: 130px;
    width: 400px;
    padding: var(--lumora-espacamento-grande);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/janela.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-right: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-top: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-janela);
}

.personagem-selecao-centro {
    position: absolute;
    left: 28%;
    right: 28%;
    top: 120px;
    bottom: 285px;
    align-items: center;
    justify-content: center;
}

.personagem-selecao-resumo {
    position: absolute;
    left: 50%;
    bottom: 36px;
    width: 560px;
    translate: -50% 0;
    align-items: center;
}

.personagem-selecao-corpo .subtitulo {
    -unity-text-align: middle-left;
    margin-bottom: var(--lumora-espacamento-medio);
}

.personagem-selecao-imagem {
    width: 100%;
    height: 100%;
    background-color: var(--lumora-cores-transparente);
    border-width: 0;
}

.personagem-selecao-resumo .personagem-item-nome {
    font-size: 34px;
    margin-bottom: 0;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px var(--lumora-cores-contorno);
}

.personagem-selecao-resumo .personagem-item-detalhes {
    margin-bottom: var(--lumora-espacamento-pequeno);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px var(--lumora-cores-contorno);
}

.personagem-entrar {
    width: 340px;
    min-height: 58px;
    font-size: 22px;
    margin: var(--lumora-espacamento-pequeno) 0 var(--lumora-espacamento-minimo);
}

.personagem-selecao-vagas > .botao {
    flex-grow: 0;
    margin: var(--lumora-espacamento-pequeno) 0 0;
}

.personagem-painel-selecao-visual > .subtitulo {
    display: none;
}

.personagem-selecao-resumo > .personagem-botao-perigo {
    min-height: 34px;
    padding: 2px var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-leitura);
    margin-top: var(--lumora-espacamento-minimo);
}

.personagem-selecao-rodape {
    position: absolute;
    left: 48px;
    bottom: 40px;
    flex-direction: row;
}

.personagem-selecao-rodape > .botao {
    flex-grow: 0;
    min-width: 140px;
}

.personagem-confirmacao-exclusao {
    width: 100%;
    margin-top: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-medio);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/dica.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-dica);
    -unity-slice-right: var(--lumora-ornamentos-fatia-dica);
    -unity-slice-top: var(--lumora-ornamentos-fatia-dica);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-dica);
}

.personagem-vaga-livre {
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin-bottom: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-controle) var(--lumora-espacamento-padrao);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-cartao);
    color: var(--lumora-cores-texto-secundario);
    -unity-font-style: italic;
    white-space: normal;
}

.personagem-lista {
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.personagem-item {
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin: 0 0 var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-controle) var(--lumora-espacamento-padrao);
    border-radius: var(--lumora-bordas-raio-cartao);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    background-color: var(--lumora-cores-campo);
    background-image: none;
    color: var(--lumora-cores-marfim);
    white-space: normal;
    font-size: var(--lumora-tipografia-controle);
}

.personagem-item:hover {
    background-color: var(--lumora-cores-hover);
    border-color: var(--lumora-cores-ouro);
}

.personagem-item:active {
    background-color: var(--lumora-cores-pressionado);
}

.personagem-item:focus {
    border-color: var(--lumora-cores-ouro);
    border-width: var(--lumora-bordas-destaque);
}

.personagem-item.personagem-item-selecionado {
    background-color: var(--lumora-cores-selecionado);
    border-color: var(--lumora-cores-ouro);
    border-left-width: var(--lumora-bordas-selecao);
}

.personagem-item:disabled {
    background-color: var(--lumora-cores-desabilitado);
    color: var(--lumora-cores-texto-desabilitado);
    border-color: var(--lumora-cores-borda-desabilitado);
}

.personagem-item-nome {
    font-size: var(--lumora-tipografia-subtitulo);
    white-space: normal;
    color: var(--lumora-cores-ouro);
}

.personagem-item-detalhes {
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    color: var(--lumora-cores-texto-secundario);
}

/* Criação. */
.personagem-escolha-raca {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.personagem-criacao-corpo .personagem-criacao-escolhas {
    position: absolute;
    left: 48px;
    top: 130px;
    bottom: 120px;
    width: 380px;
    margin: 0;
    padding: var(--lumora-espacamento-grande);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/janela.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-right: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-top: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-janela);
}

.personagem-criacao-centro {
    position: absolute;
    left: 470px;
    right: 490px;
    top: 120px;
    bottom: 36px;
    align-items: center;
}

/* Palco da prévia: o pedestal fica atrás do personagem, na altura dos pés (a câmera deixa
   cerca de 7,5% de margem embaixo do modelo). */
.personagem-palco {
    flex-grow: 1;
    width: 100%;
}

.personagem-palco > .personagem-selecao-imagem {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
}

.personagem-pedestal {
    position: absolute;
    left: 50%;
    bottom: 1.5%;
    width: 360px;
    height: 12%;
    translate: -50% 0;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/pedestal.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.personagem-criacao-corpo .personagem-criacao-informacoes {
    position: absolute;
    right: 48px;
    top: 130px;
    bottom: 120px;
    width: 420px;
    flex-grow: 0;
    padding: var(--lumora-espacamento-grande);
    background-color: var(--lumora-cores-transparente);
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/janela.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-right: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-top: var(--lumora-ornamentos-fatia-janela);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-janela);
    border-width: 0;
}

.personagem-criacao-corpo .subtitulo {
    -unity-text-align: middle-left;
    margin-bottom: var(--lumora-espacamento-medio);
}

.personagem-criacao-informacoes > .botao {
    margin: var(--lumora-espacamento-pequeno) 0 0;
}

.personagem-criacao-informacoes > .botao-principal {
    flex-grow: 0;
    min-height: 56px;
    font-size: 22px;
    margin-top: auto;
}

.personagem-criacao-erro-nome {
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-bottom: var(--lumora-espacamento-medio);
}

.personagem-criacao-aparencia {
    width: 100%;
    max-width: 640px;
    padding: var(--lumora-espacamento-medio) var(--lumora-espacamento-grande);
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/placa.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-right: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-top: var(--lumora-ornamentos-fatia-placa);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-placa);
}

.personagem-criacao-aparencia > .subtitulo {
    width: 100%;
    -unity-text-align: middle-center;
    margin-bottom: var(--lumora-espacamento-pequeno);
    font-size: var(--lumora-tipografia-controle);
}

.personagem-lista-racas {
    width: var(--lumora-dimensoes-item);
    margin-right: var(--lumora-espacamento-medio);
    flex-shrink: 0;
}

.personagem-raca-botao {
    min-height: 52px;
    margin-bottom: var(--lumora-espacamento-minimo);
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    -unity-text-align: middle-left;
    font-size: var(--lumora-tipografia-controle);
}

.personagem-cartao-raca {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.personagem-cartao-texto, .personagem-cartao-citacao {
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    margin-top: var(--lumora-espacamento-curto);
    color: var(--lumora-cores-marfim);
}

.personagem-cartao-citacao {
    margin-top: var(--lumora-espacamento-controle);
    color: var(--lumora-cores-ouro);
    -unity-font-style: italic;
}

.lumora-compacto .personagem-selecao-vagas {
    width: 320px;
    right: 16px;
}

.lumora-compacto .personagem-criacao-corpo .personagem-criacao-escolhas {
    left: 16px;
    width: 300px;
}

.lumora-compacto .personagem-criacao-corpo .personagem-criacao-informacoes {
    right: 16px;
    width: 320px;
}

.lumora-compacto .personagem-criacao-centro {
    left: 330px;
    right: 350px;
}

.personagem-hud-barra-xp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.personagem-hud-barra-xp-trilho {
    flex-grow: 1;
    padding: 2px;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-fundo.png");
    -unity-slice-left: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-right: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-top: var(--lumora-ornamentos-fatia-barra);
    -unity-slice-bottom: var(--lumora-ornamentos-fatia-barra);
    justify-content: center;
}

.personagem-hud-barra-xp-preenchimento {
    position: absolute;
    left: 2px;
    top: 2px;
    bottom: 2px;
    width: 0;
    background-image: url("../../../../../Core/UI/Visual/Resources/Lumora/Arte/Hud/barra-preenchimento.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--lumora-cores-experiencia);
}

.personagem-hud-barra-xp-marca {
    position: absolute;
    top: 3px;
    bottom: 3px;
    width: 1px;
    background-color: var(--lumora-cores-contorno);
    opacity: 0.6;
}

.personagem-hud-barra-xp-rotulo {
    font-size: var(--lumora-tipografia-tecla);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px var(--lumora-cores-contorno);
    margin: 0;
    padding: 0;
}

.personagem-painel-queda {
    max-width: var(--lumora-dimensoes-dialogo);
    align-items: center;
}

.personagem-queda-contagem {
    font-size: var(--lumora-tipografia-titulo);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--lumora-cores-ouro);
    margin-bottom: var(--lumora-espacamento-medio);
}

.personagem-queda-estado-aguardando,
.personagem-queda-estado-levantando {
    min-width: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.personagem-queda-estado-aguardando {
    color: var(--lumora-cores-texto-secundario);
}

.personagem-queda-estado-levantando {
    color: var(--lumora-cores-essencia);
}

.personagem-queda-trilho {
    width: 100%;
    margin-top: var(--lumora-espacamento-pequeno);
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.personagem-queda-preenchimento {
    background-color: var(--lumora-cores-ouro);
}

.personagem-queda-hold-ativo {
    border-color: var(--lumora-cores-essencia);
}

.lumora-compacto .personagem-painel-queda {
    max-height: var(--lumora-dimensoes-dialogo-percentual);
}

/* Aparência básica na criação */
.personagem-criacao-aparencia {
    margin-top: var(--lumora-espacamento-medio);
    padding: var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.personagem-stepper-item {
    margin-bottom: var(--lumora-espacamento-curto);
}

.personagem-stepper-linha {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
}

.personagem-stepper-botao {
    width: 32px;
    height: 28px;
    padding: 0;
    -unity-text-align: middle-center;
}

.personagem-stepper-valor {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
}

/* Confirmação de exclusão */
.personagem-confirmacao-exclusao {
    margin-top: var(--lumora-espacamento-medio);
    padding: var(--lumora-espacamento-padrao);
    background-color: var(--lumora-cores-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-erro);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.personagem-confirmacao-exclusao .campo {
    margin-top: var(--lumora-espacamento-curto);
    margin-bottom: var(--lumora-espacamento-curto);
}

.personagem-botao-perigo {
    color: var(--lumora-cores-erro);
    border-color: var(--lumora-cores-erro);
}
