/*
 * Estilo das telas de Personagem. Complementa o EstiloCore.uss.
 * Os nomes das classes estão em EstiloPersonagem.cs.
 * Mesma moldura do Core: cantos retos, borda dourada, texto quente.
 */

.personagem-painel-selecao {
    width: 640px;
}

.personagem-lista {
    margin-bottom: 8px;
}

.personagem-item {
    flex-direction: column;
    align-items: flex-start;
    min-height: 72px;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 8px;
    padding: 10px 16px;
    border-radius: 0;
    border-width: 0;
    background-color: rgb(28, 22, 16);
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/slot.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    color: rgb(228, 214, 188);
}

.personagem-item:hover {
    background-color: rgb(48, 36, 24);
    border-top-color: rgb(168, 132, 68);
}

.personagem-item-selecionado {
    border-color: rgb(212, 176, 96);
    background-color: rgb(58, 42, 22);
    -unity-background-image-tint-color: rgb(255, 214, 140);
}

.personagem-item-selecionado:hover {
    background-color: rgb(68, 50, 26);
}

/* Mantém a borda e o fundo da seleção quando o tema aplica :focus/:active ao botão. */
.personagem-item.personagem-item-selecionado:focus,
.personagem-item.personagem-item-selecionado:active {
    border-color: rgb(212, 176, 96);
    background-color: rgb(68, 50, 26);
}

.personagem-item-nome {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(236, 214, 160);
}

.personagem-item-detalhes {
    font-size: 18px;
    -unity-text-align: middle-left;
    color: rgb(176, 148, 104);
}

.personagem-racas .unity-radio-button {
    font-size: 20px;
    color: rgb(228, 214, 188);
    margin-bottom: 4px;
}

.personagem-escolha-raca {
    flex-direction: row;
    margin-bottom: 8px;
}

.personagem-lista-racas {
    width: 200px;
    margin-right: 12px;
}

.personagem-raca-botao {
    min-height: 44px;
    margin-bottom: 4px;
    padding: 4px 12px;
    font-size: 20px;
    -unity-text-align: middle-left;
}

.personagem-cartao-raca {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 10px 16px;
    background-color: rgb(28, 22, 16);
    border-width: 1px;
    border-color: rgb(120, 92, 52);
}

.personagem-cartao-texto {
    font-size: 16px;
    white-space: normal;
    margin-top: 6px;
    color: rgb(228, 214, 188);
}

.personagem-cartao-citacao {
    font-size: 16px;
    white-space: normal;
    margin-top: 10px;
    -unity-font-style: italic;
    color: rgb(212, 176, 96);
}
