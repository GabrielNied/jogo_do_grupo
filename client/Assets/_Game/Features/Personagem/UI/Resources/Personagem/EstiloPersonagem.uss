/*
 * Estilo das telas de Personagem (provisório: uma pessoa ajusta o visual depois).
 * Complementa o EstiloCore.uss; os nomes das classes estão em EstiloPersonagem.cs.
 */

.personagem-painel-selecao {
    width: 640px;
}

.personagem-lista {
    margin-bottom: 8px;
}

.personagem-item {
    flex-direction: column;
    align-items: flex-start;
    min-height: 72px;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 8px;
    padding: 10px 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(44, 52, 68);
}

.personagem-item:hover {
    background-color: rgb(56, 66, 86);
}

.personagem-item-selecionado {
    border-color: rgb(80, 170, 110);
    background-color: rgb(40, 70, 56);
}

.personagem-item-selecionado:hover {
    background-color: rgb(46, 82, 64);
}

/* Mantém a borda e o fundo da seleção quando o tema aplica :focus/:active ao botão. */
.personagem-item.personagem-item-selecionado:focus,
.personagem-item.personagem-item-selecionado:active {
    border-color: rgb(80, 170, 110);
    background-color: rgb(46, 82, 64);
}

.personagem-item-nome {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(240, 240, 240);
}

.personagem-item-detalhes {
    font-size: 20px;
    -unity-text-align: middle-left;
    color: rgb(180, 188, 200);
}

.personagem-racas .unity-radio-button {
    font-size: 22px;
    color: rgb(220, 224, 230);
    margin-bottom: 4px;
}
