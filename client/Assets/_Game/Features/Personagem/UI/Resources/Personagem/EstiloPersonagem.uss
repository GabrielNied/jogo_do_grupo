/* Lumora: seleção e criação, complementa os componentes compartilhados. */
.personagem-painel-selecao {
    width: var(--lumora-dimensoes-painel-largo);
}

.personagem-lista {
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.personagem-item {
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin: 0 0 var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-controle) var(--lumora-espacamento-padrao);
    border-radius: var(--lumora-bordas-raio-cartao);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    background-color: var(--lumora-cores-campo);
    color: var(--lumora-cores-marfim);
    white-space: normal;
    font-size: var(--lumora-tipografia-controle);
}

.personagem-item:hover {
    background-color: var(--lumora-cores-hover);
    border-color: var(--lumora-cores-ouro);
}

.personagem-item:active {
    background-color: var(--lumora-cores-pressionado);
}

.personagem-item:focus {
    border-color: var(--lumora-cores-essencia);
    border-width: var(--lumora-bordas-destaque);
}

.personagem-item.personagem-item-selecionado {
    background-color: var(--lumora-cores-selecionado);
    border-color: var(--lumora-cores-essencia);
    border-left-width: var(--lumora-bordas-selecao);
}

.personagem-item:disabled {
    background-color: var(--lumora-cores-desabilitado);
    color: var(--lumora-cores-texto-desabilitado);
    border-color: var(--lumora-cores-borda-desabilitado);
}

.personagem-item-nome {
    font-size: var(--lumora-tipografia-subtitulo);
    white-space: normal;
    color: var(--lumora-cores-ouro);
}

.personagem-item-detalhes {
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    color: var(--lumora-cores-texto-secundario);
}

.personagem-escolha-raca {
    flex-direction: row;
    margin-bottom: var(--lumora-espacamento-pequeno);
    min-width: 0;
}

.personagem-lista-racas {
    width: var(--lumora-dimensoes-item);
    margin-right: var(--lumora-espacamento-medio);
    flex-shrink: 0;
}

.personagem-raca-botao {
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin-bottom: var(--lumora-espacamento-minimo);
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    -unity-text-align: middle-left;
}

.personagem-cartao-raca {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: var(--lumora-espacamento-controle) var(--lumora-espacamento-padrao);
    background-color: var(--lumora-cores-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.personagem-cartao-texto, .personagem-cartao-citacao {
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    margin-top: var(--lumora-espacamento-curto);
    color: var(--lumora-cores-marfim);
}

.personagem-cartao-citacao {
    margin-top: var(--lumora-espacamento-controle);
    color: var(--lumora-cores-ouro);
}

.lumora-estreito .personagem-escolha-raca {
    flex-direction: column;
}

.lumora-estreito .personagem-lista-racas {
    width: 100%;
    margin-right: 0;
}

.personagem-hud-barra-xp {
    width: var(--lumora-dimensoes-recursos-largura);
    max-width: var(--lumora-dimensoes-dialogo-percentual);
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.personagem-hud-barra-xp-rotulo {
    margin-bottom: var(--lumora-espacamento-curto);
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    -unity-text-align: middle-left;
}

.personagem-hud-barra-xp-trilho {
    min-height: var(--lumora-dimensoes-barra);
    background-color: var(--lumora-cores-trilho);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-campo);
    overflow: hidden;
}

.personagem-hud-barra-xp-preenchimento {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: var(--lumora-cores-essencia);
}

.personagem-painel-queda {
    max-width: var(--lumora-dimensoes-dialogo);
    align-items: center;
}

.personagem-queda-contagem {
    font-size: var(--lumora-tipografia-titulo);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--lumora-cores-ouro);
    margin-bottom: var(--lumora-espacamento-medio);
}

.personagem-queda-estado-aguardando,
.personagem-queda-estado-levantando {
    min-width: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.personagem-queda-estado-aguardando {
    color: var(--lumora-cores-texto-secundario);
}

.personagem-queda-estado-levantando {
    color: var(--lumora-cores-essencia);
}

.personagem-queda-trilho {
    width: 100%;
    margin-top: var(--lumora-espacamento-pequeno);
    margin-bottom: var(--lumora-espacamento-pequeno);
}

.personagem-queda-preenchimento {
    background-color: var(--lumora-cores-ouro);
}

.personagem-queda-hold-ativo {
    border-color: var(--lumora-cores-essencia);
}

.lumora-compacto .personagem-painel-queda {
    max-height: var(--lumora-dimensoes-dialogo-percentual);
}
