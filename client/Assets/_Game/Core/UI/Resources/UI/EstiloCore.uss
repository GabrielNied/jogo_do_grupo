/*
 * Visual das telas: moldura de jogo (painel escuro, borda dourada, cantos retos).
 * Carregado pelo Core na raiz da interface, então vale também para as funcionalidades.
 * Os nomes das classes estão em EstiloCore.cs. Cor e tamanho ficam aqui, não no C#.
 * A regra está em docs/arquitetura.md (seção "Estilo").
 */

.raiz-interface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tela {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 6, 5);
}

.tela-sobre-jogo {
    background-color: rgba(0, 0, 0, 0.62);
}

.painel {
    width: 560px;
    padding: 28px 32px;
    background-color: rgb(22, 16, 12);
    border-radius: 0;
    border-width: 2px;
    border-top-color: rgb(196, 160, 88);
    border-left-color: rgb(168, 132, 68);
    border-right-color: rgb(74, 52, 24);
    border-bottom-color: rgb(52, 36, 16);
}

.painel-largo {
    width: 640px;
    max-height: 90%;
}

.titulo {
    font-size: 40px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 196, 120);
    margin-bottom: 8px;
}

.subtitulo {
    font-size: 20px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(176, 148, 104);
    margin-bottom: 20px;
}

.texto {
    font-size: 20px;
    color: rgb(228, 214, 188);
    white-space: normal;
}

.texto-ganho {
    color: rgb(126, 196, 96);
}

.linha-lista {
    margin-bottom: 4px;
}

.campo {
    flex-direction: column;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 16px;
}

.campo > .unity-base-field__label {
    min-width: 0;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(196, 164, 112);
    margin-bottom: 6px;
}

.campo .unity-base-text-field__input {
    min-height: 44px;
    font-size: 22px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(236, 224, 200);
    background-color: rgb(10, 8, 6);
    background-image: none;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(120, 92, 48);
}

.campo .unity-base-text-field__input:focus {
    border-color: rgb(212, 176, 96);
}

.linha-botoes {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
    margin-left: -4px;
    margin-right: -4px;
}

.botao {
    flex-grow: 1;
    min-height: 48px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 8px;
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(232, 214, 176);
    background-color: rgb(42, 32, 22);
    background-image: none;
    border-radius: 0;
    border-width: 2px;
    border-top-color: rgb(168, 132, 68);
    border-left-color: rgb(148, 112, 56);
    border-right-color: rgb(70, 48, 22);
    border-bottom-color: rgb(48, 32, 14);
}

.botao:hover {
    color: rgb(255, 236, 196);
    background-color: rgb(64, 48, 30);
    border-top-color: rgb(220, 180, 96);
}

.botao:focus {
    border-top-color: rgb(220, 180, 96);
}

.botao:disabled {
    opacity: 0.45;
}

.botao-principal {
    color: rgb(255, 228, 170);
    background-color: rgb(92, 62, 22);
    border-top-color: rgb(232, 196, 112);
    border-left-color: rgb(200, 160, 80);
}

.botao-principal:hover {
    background-color: rgb(112, 76, 28);
    border-top-color: rgb(244, 214, 140);
}

.linha-botoes > .botao {
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
}

.mensagem {
    min-height: 32px;
    margin-top: 12px;
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(196, 176, 144);
}

.mensagem-erro {
    color: rgb(220, 84, 64);
}

.mensagem-aviso {
    color: rgb(232, 186, 96);
}

.lista {
    height: 320px;
    flex-shrink: 1;
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgb(10, 8, 6);
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(92, 70, 36);
}

.barra-carregamento {
    width: 480px;
    height: 14px;
    margin-top: 24px;
    border-radius: 0;
    background-color: rgb(10, 8, 6);
    border-width: 1px;
    border-color: rgb(120, 92, 48);
    overflow: hidden;
}

.barra-carregamento-preenchimento {
    width: 0;
    height: 100%;
    background-color: rgb(196, 152, 64);
}

.dica {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    font-size: 26px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 220, 140);
}
