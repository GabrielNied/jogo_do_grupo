/*
 * Visual das telas: moldura, botão e campo em textura 9-slice (arte nossa).
 * As png são geradas por scripts/ui/gerar-moldura.mjs. Não desenhe outra à mão.
 * Carregado pelo Core na raiz da interface, então vale também para as funcionalidades.
 * Os nomes das classes estão em EstiloCore.cs. Cor e tamanho ficam aqui, não no C#.
 * A regra está em docs/arquitetura.md (seção "Estilo").
 */

.raiz-interface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    picking-mode: Ignore;
}

.tela {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 6, 5);
}

.tela-sobre-jogo {
    background-color: rgba(0, 0, 0, 0.62);
}

.painel {
    width: 560px;
    padding: 40px 44px;
    background-color: rgb(22, 16, 12);
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/moldura.png");
    -unity-slice-left: 36;
    -unity-slice-right: 36;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    border-radius: 0;
    border-width: 0;
}

.painel-largo {
    width: 640px;
    max-height: 90%;
}

.titulo {
    font-size: 40px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(232, 196, 120);
    margin-bottom: 8px;
}

.subtitulo {
    font-size: 20px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(176, 148, 104);
    margin-bottom: 20px;
}

.texto {
    font-size: 20px;
    color: rgb(228, 214, 188);
    white-space: normal;
}

.texto-ganho {
    color: rgb(126, 196, 96);
}

.linha-lista {
    min-height: 40px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/slot.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
}

.campo {
    flex-direction: column;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 16px;
}

.campo > .unity-base-field__label {
    min-width: 0;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(196, 164, 112);
    margin-bottom: 6px;
}

.campo .unity-base-text-field__input {
    min-height: 44px;
    font-size: 22px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(236, 224, 200);
    background-color: rgb(10, 8, 6);
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/campo.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    border-radius: 0;
    border-width: 0;
}

.campo .unity-base-text-field__input:focus {
    border-color: rgb(212, 176, 96);
}

.linha-botoes {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
    margin-left: -4px;
    margin-right: -4px;
}

.botao {
    flex-grow: 1;
    min-height: 48px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 8px;
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(244, 228, 196);
    background-color: rgb(42, 32, 22);
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/botao.png");
    -unity-slice-left: 10;
    -unity-slice-right: 10;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-radius: 0;
    border-width: 0;
}

.botao:hover {
    color: rgb(255, 244, 214);
    -unity-background-image-tint-color: rgb(255, 228, 176);
}

.botao:focus {
    -unity-background-image-tint-color: rgb(255, 228, 176);
}

.botao:disabled {
    opacity: 0.45;
}

.botao-principal {
    color: rgb(255, 236, 196);
    background-color: rgb(92, 62, 22);
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/botao-principal.png");
}

.botao-principal:hover {
    -unity-background-image-tint-color: rgb(255, 236, 200);
}

.linha-botoes > .botao {
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
}

.mensagem {
    min-height: 32px;
    margin-top: 12px;
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(196, 176, 144);
}

.mensagem-erro {
    color: rgb(220, 84, 64);
}

.mensagem-aviso {
    color: rgb(232, 186, 96);
}

.lista {
    height: 320px;
    flex-shrink: 1;
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgb(10, 8, 6);
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/campo.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    border-radius: 0;
    border-width: 0;
}

.barra-carregamento {
    width: 480px;
    height: 14px;
    margin-top: 24px;
    border-radius: 0;
    background-color: rgb(10, 8, 6);
    border-width: 1px;
    border-color: rgb(120, 92, 48);
    overflow: hidden;
}

.barra-carregamento-preenchimento {
    width: 0;
    height: 100%;
    background-color: rgb(196, 152, 64);
}

.dica {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    font-size: 26px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 220, 140);
}

/* Janelas do jogo abertas por atalho (C, I, L, M): a mesma moldura para todas. */

.janela {
    padding-top: 28px;
}

.janela-cabecalho {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 92, 48);
}

.janela-titulo {
    flex-grow: 1;
    font-size: 32px;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.janela-fechar {
    flex-grow: 0;
    width: 44px;
    min-height: 44px;
    margin-top: 0;
    padding: 0;
}

.janela-conteudo {
    flex-shrink: 1;
    min-height: 120px;
}

.janela-rodape {
    margin-top: 16px;
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(150, 128, 92);
}

.linha-dado {
    flex-direction: row;
    justify-content: space-between;
    min-height: 40px;
    margin-bottom: 6px;
    padding: 6px 12px;
    background-image: url("project://database/Assets/_Game/Core/UI/Resources/UI/slot.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
}

.rotulo-dado {
    color: rgb(196, 164, 112);
}

/* Barra de atalhos: só mostra as teclas, não recebe clique. */

.barra-atalhos {
    position: absolute;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
}

.atalho {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
    opacity: 0.8;
}

.atalho-ativo {
    opacity: 1;
}

.atalho-tecla {
    min-width: 30px;
    height: 30px;
    padding: 0 6px;
    margin-right: 6px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 228, 196);
    background-color: rgba(22, 16, 12, 0.85);
    border-width: 1px;
    border-color: rgb(120, 92, 48);
}

.atalho-nome {
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(228, 214, 188);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.atalho-ativo > .atalho-tecla {
    color: rgb(22, 16, 12);
    background-color: rgb(232, 196, 120);
    border-color: rgb(255, 236, 196);
}

.atalho-ativo > .atalho-nome {
    color: rgb(255, 220, 140);
}

/*
 * HUD do jogo: uma região por parte da tela (docs/features/interface.md, "HUD do jogo").
 * Nada aqui recebe clique. Cada funcionalidade põe o seu elemento na sua região, que já
 * está posicionada: o elemento dela não precisa de position: absolute.
 */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-regiao {
    position: absolute;
}

.hud-inferior-esquerda {
    left: 24px;
    bottom: 24px;
    align-items: flex-start;
}

.hud-lateral-esquerda {
    left: 24px;
    bottom: 50%;
    align-items: flex-start;
    justify-content: flex-end;
}

.hud-topo-centro {
    left: 0;
    right: 0;
    top: 24px;
    align-items: center;
}

.hud-centro-avisos {
    left: 0;
    right: 0;
    top: 140px;
    align-items: center;
}

.hud-inferior-centro {
    left: 0;
    right: 0;
    bottom: 180px;
    align-items: center;
}

.hud-superior-direita {
    right: 24px;
    top: 24px;
    align-items: flex-end;
}

/* Mensagens de sistema: a linha nova entra embaixo e empurra as outras para cima. */

.avisos {
    align-items: center;
}

.aviso {
    margin-top: 4px;
    padding: 2px 12px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.45);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.aviso-informacao {
    color: rgb(244, 238, 226);
}

.aviso-aviso {
    color: rgb(240, 200, 90);
}

.aviso-erro {
    color: rgb(228, 84, 64);
}
