/* Integração das classes históricas com Lumora. Valores: design/interface/config-visual.json. */
.raiz-interface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tela {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: var(--lumora-espacamento-padrao);
    background-color: var(--lumora-cores-petroleo);
    background-image: url("../../Visual/Resources/Lumora/Arte/fundo-petrol.png");
}

.tela-sobre-jogo {
    background-color: var(--lumora-cores-veu);
    background-image: none;
}

.tela-com-transicao {
    transition-property: opacity;
    transition-duration: 0.2s;
}

.painel {
    width: var(--lumora-dimensoes-painel-entrada);
    max-width: 100%;
    max-height: var(--lumora-dimensoes-dialogo-percentual);
    flex-shrink: 1;
}

.painel-largo {
    width: var(--lumora-dimensoes-painel-largo);
}

.menu-jogo-aviso {
    margin-bottom: var(--lumora-espacamento-amplo);
    color: var(--lumora-cores-texto-secundario);
    -unity-text-align: middle-center;
}

.menu-jogo-acao {
    flex-grow: 0;
    margin: 0 0 var(--lumora-espacamento-pequeno);
}

.menu-jogo-saidas {
    margin-top: var(--lumora-espacamento-padrao);
    padding-top: var(--lumora-espacamento-padrao);
    border-top-width: var(--lumora-bordas-fina);
    border-top-color: var(--lumora-cores-borda-discreta);
}

.menu-jogo-saidas .subtitulo {
    -unity-text-align: middle-left;
    margin-bottom: var(--lumora-espacamento-medio);
}

.menu-jogo-dica {
    margin-top: var(--lumora-espacamento-padrao);
}

.opcoes-painel {
    width: var(--lumora-dimensoes-painel-largo);
}

.opcoes-abas {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--lumora-espacamento-amplo);
}

.opcoes-aba {
    flex-grow: 1;
    min-width: 0;
    margin: var(--lumora-espacamento-minimo);
}

.opcoes-aba-ativa {
    background-color: var(--lumora-cores-selecionado);
    border-color: var(--lumora-cores-essencia);
}

.opcoes-conteudo {
    min-width: 0;
    min-height: 0;
    flex-shrink: 1;
}

.opcoes-tecla-linha {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin-bottom: var(--lumora-espacamento-pequeno);
    border-bottom-width: var(--lumora-bordas-fina);
    border-bottom-color: var(--lumora-cores-borda-discreta);
}

.opcoes-tecla-nome {
    flex-grow: 1;
    min-width: var(--lumora-dimensoes-retrato);
    color: var(--lumora-cores-marfim);
}

.opcoes-tecla-atual {
    min-width: var(--lumora-dimensoes-retrato);
    color: var(--lumora-cores-ouro);
}

.opcoes-tecla-linha .botao {
    margin: var(--lumora-espacamento-minimo);
}

.opcoes-linha {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    margin-bottom: var(--lumora-espacamento-padrao);
}

.opcoes-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--lumora-cores-marfim);
}

.opcoes-slider .unity-base-field__label,
.opcoes-campo .unity-base-field__label {
    color: var(--lumora-cores-texto-secundario);
    font-size: var(--lumora-tipografia-controle);
    white-space: normal;
}

.opcoes-slider .unity-slider__tracker {
    background-color: var(--lumora-cores-trilho);
}

.opcoes-slider .unity-slider__dragger {
    background-color: var(--lumora-cores-essencia);
    border-color: var(--lumora-cores-ouro);
}

.opcoes-slider:focus .unity-slider__dragger {
    border-width: var(--lumora-bordas-destaque);
}

.opcoes-valor {
    min-width: var(--lumora-dimensoes-retrato);
    color: var(--lumora-cores-ouro);
    -unity-text-align: middle-right;
}

.opcoes-campo {
    min-height: var(--lumora-dimensoes-alvo-minimo);
    min-width: 0;
    margin-bottom: var(--lumora-espacamento-padrao);
    color: var(--lumora-cores-marfim);
}

.opcoes-campo .unity-base-popup-field__input {
    background-color: var(--lumora-cores-campo);
    color: var(--lumora-cores-marfim);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-campo);
}

.opcoes-campo:focus .unity-base-popup-field__input {
    border-color: var(--lumora-cores-essencia);
}

.opcoes-aplicar,
.opcoes-voltar {
    margin: var(--lumora-espacamento-pequeno) 0 0;
}

.lumora-estreito .opcoes-abas {
    flex-direction: column;
}

.lumora-estreito .opcoes-linha {
    flex-direction: column;
    align-items: stretch;
}

.lumora-estreito .opcoes-tecla-linha {
    flex-direction: column;
    align-items: stretch;
}

.login-composicao {
    width: var(--lumora-dimensoes-painel-entrada);
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    align-items: center;
    flex-shrink: 1;
}

.login-marca {
    margin-bottom: var(--lumora-espacamento-padrao);
}

.login-painel {
    width: 100%;
    max-height: 100%;
    min-height: 0;
}

.login-mensagem {
    margin-top: 0;
    margin-bottom: var(--lumora-espacamento-medio);
}

.login-acoes {
    min-width: 0;
    flex-shrink: 0;
}

.login-acoes > .botao {
    flex-grow: 0;
    margin: 0 0 var(--lumora-espacamento-pequeno);
}

.login-acoes > .login-acao-secundaria {
    margin-bottom: 0;
}

.entrada-mundo-painel {
    width: var(--lumora-dimensoes-painel-entrada);
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    align-items: stretch;
}

.abertura-painel {
    width: var(--lumora-dimensoes-painel-entrada);
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    align-items: stretch;
}

.abertura-estado {
    white-space: normal;
}

.conexao-latencia {
    padding: var(--lumora-espacamento-minimo) var(--lumora-espacamento-pequeno);
    margin-bottom: var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-painel);
    border-radius: var(--lumora-bordas-raio-cartao);
    color: var(--lumora-cores-marfim);
}

.conexao-faixa {
    position: absolute;
    left: var(--lumora-espacamento-padrao);
    right: var(--lumora-espacamento-padrao);
    top: var(--lumora-espacamento-padrao);
    align-items: center;
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-painel);
    border-bottom-width: var(--lumora-bordas-destaque);
    border-bottom-color: var(--lumora-cores-ouro);
}

.conexao-modal-painel {
    width: var(--lumora-dimensoes-painel-entrada);
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
}

.conexao-modal-painel .mensagem {
    white-space: normal;
    margin-bottom: var(--lumora-espacamento-padrao);
}

.conexao-modal-painel .linha-botoes {
    flex-wrap: wrap;
}

.conexao-modal-painel .linha-botoes > .botao {
    flex-grow: 1;
    min-width: var(--lumora-dimensoes-alvo-minimo);
}

.lumora-estreito .conexao-modal-painel .linha-botoes {
    flex-direction: column;
}

.entrada-mundo-estado {
    white-space: normal;
    margin-bottom: var(--lumora-espacamento-padrao);
}

.entrada-mundo-etapa {
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    margin-bottom: var(--lumora-espacamento-pequeno);
    color: var(--lumora-cores-texto-secundario);
    background-color: var(--lumora-cores-campo);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.entrada-mundo-etapa-ativa {
    color: var(--lumora-cores-ouro);
    border-left-width: var(--lumora-bordas-destaque);
    border-left-color: var(--lumora-cores-ouro);
}

.entrada-mundo-etapa-pronta {
    color: var(--lumora-cores-marfim);
}

.entrada-mundo-erro {
    white-space: normal;
    margin-bottom: var(--lumora-espacamento-padrao);
}

.entrada-mundo-painel .linha-botoes {
    flex-wrap: wrap;
}

.entrada-mundo-painel .linha-botoes > .botao {
    min-width: var(--lumora-dimensoes-alvo-minimo);
    flex-grow: 1;
}

.lumora-estreito .entrada-mundo-painel .linha-botoes {
    flex-direction: column;
}

.titulo {
    -unity-text-align: middle-center;
    margin-bottom: var(--lumora-espacamento-pequeno);
    flex-shrink: 0;
}

.subtitulo {
    -unity-text-align: middle-center;
    color: var(--lumora-cores-texto-secundario);
    margin-bottom: var(--lumora-espacamento-amplo);
}

.texto-ganho {
    color: var(--lumora-cores-ganho);
}

.linha-lista, .linha-dado {
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin-bottom: var(--lumora-espacamento-curto);
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-campo);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-discreta);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.linha-dado {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.linha-dado > .texto {
    flex-shrink: 1;
    min-width: 0;
    margin-right: var(--lumora-espacamento-pequeno);
}

.rotulo-dado {
    color: var(--lumora-cores-texto-secundario);
}

.linha-botoes {
    margin-top: var(--lumora-espacamento-pequeno);
    flex-shrink: 0;
}

.botao {
    margin: var(--lumora-espacamento-minimo);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mensagem {
    min-height: var(--lumora-dimensoes-mensagem);
    margin-top: var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--lumora-cores-texto-secundario);
    flex-shrink: 0;
}

.mensagem-erro {
    color: var(--lumora-cores-erro);
}

.mensagem-aviso {
    color: var(--lumora-cores-ouro);
}

.lista {
    height: var(--lumora-dimensoes-lista);
    flex-shrink: 1;
    min-height: var(--lumora-dimensoes-alvo-minimo);
    margin-bottom: var(--lumora-espacamento-pequeno);
    padding: var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-campo);
    border-radius: var(--lumora-bordas-raio-campo);
}

.barra-carregamento {
    width: var(--lumora-dimensoes-dialogo);
    max-width: 100%;
    height: var(--lumora-dimensoes-carregamento);
    margin-top: var(--lumora-espacamento-grande);
    border-radius: var(--lumora-bordas-raio-campo);
    background-color: var(--lumora-cores-trilho);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
    overflow: hidden;
}

.barra-carregamento-preenchimento {
    width: 0;
    height: 100%;
    background-color: var(--lumora-cores-essencia);
}

.dica {
    position: absolute;
    left: var(--lumora-espacamento-padrao);
    right: var(--lumora-espacamento-padrao);
    bottom: var(--lumora-dimensoes-dica-base);
    font-size: var(--lumora-tipografia-subtitulo);
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--lumora-cores-ouro);
    text-shadow: var(--lumora-bordas-fina) var(--lumora-bordas-fina) var(--lumora-cores-sombra);
}

.janela-cabecalho {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--lumora-espacamento-padrao);
    padding-bottom: var(--lumora-espacamento-medio);
    border-bottom-width: var(--lumora-bordas-fina);
    border-bottom-color: var(--lumora-cores-borda-botao);
}

.janela-titulo {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.janela-fechar {
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--lumora-dimensoes-alvo-minimo);
    min-height: var(--lumora-dimensoes-alvo-minimo);
    padding: 0;
}

.janela-conteudo {
    min-width: 0;
    flex-shrink: 0;
}

.janela-rodape {
    margin-top: var(--lumora-espacamento-padrao);
    font-size: var(--lumora-tipografia-leitura);
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--lumora-cores-texto-secundario);
}

.janela-raiz-tela-inteira {
    padding: 0;
    background-image: none;
    background-color: var(--lumora-cores-petroleo);
}

.janela-tela-inteira {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    min-width: 0;
    min-height: 0;
}

.janela-tela-inteira .janela-conteudo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    min-width: 0;
    min-height: 0;
}

.janela-tela-inteira .janela-cabecalho {
    position: absolute;
    left: var(--lumora-espacamento-padrao);
    right: var(--lumora-espacamento-padrao);
    top: var(--lumora-espacamento-padrao);
    padding: var(--lumora-espacamento-pequeno) var(--lumora-espacamento-medio);
    background-color: var(--lumora-cores-topo);
    border-width: 0;
    border-radius: var(--lumora-bordas-raio-cartao);
}

.janela-tela-inteira .janela-rodape {
    position: absolute;
    left: var(--lumora-espacamento-padrao);
    bottom: var(--lumora-espacamento-padrao);
    margin: 0;
    padding: var(--lumora-espacamento-pequeno);
    background-color: var(--lumora-cores-painel);
    border-radius: var(--lumora-bordas-raio-cartao);
}

.barra-atalhos {
    position: absolute;
    left: var(--lumora-espacamento-grande);
    right: var(--lumora-espacamento-grande);
    bottom: var(--lumora-espacamento-grande);
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.atalho {
    flex-direction: row;
    align-items: center;
    margin-left: var(--lumora-espacamento-medio);
    margin-top: var(--lumora-espacamento-minimo);
    padding: var(--lumora-espacamento-minimo);
    background-color: var(--lumora-cores-painel);
    border-radius: var(--lumora-bordas-raio-campo);
}

.atalho-tecla {
    min-width: var(--lumora-dimensoes-barra);
    min-height: var(--lumora-dimensoes-barra);
    padding: 0 var(--lumora-espacamento-curto);
    margin-right: var(--lumora-espacamento-curto);
    font-size: var(--lumora-tipografia-leitura);
    -unity-text-align: middle-center;
    color: var(--lumora-cores-marfim);
    border-width: var(--lumora-bordas-fina);
    border-color: var(--lumora-cores-borda-botao);
}

.atalho-nome {
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
}

.atalho-ativo > .atalho-tecla {
    color: var(--lumora-cores-petroleo);
    background-color: var(--lumora-cores-ouro);
}

.atalho-ativo > .atalho-nome {
    color: var(--lumora-cores-ouro);
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-regiao {
    position: absolute;
    max-width: var(--lumora-dimensoes-dialogo-percentual);
}

.hud-inferior-esquerda {
    left: var(--lumora-espacamento-grande);
    bottom: var(--lumora-dimensoes-status);
    width: var(--lumora-dimensoes-recursos-largura);
    max-width: 42%;
    align-items: flex-start;
}

.hud-chat {
    left: var(--lumora-espacamento-grande);
    bottom: var(--lumora-dimensoes-hud-chat-base);
    width: var(--lumora-dimensoes-chat-largura);
    max-width: 42%;
    align-items: flex-start;
}

.hud-lateral-esquerda {
    left: var(--lumora-espacamento-grande);
    bottom: 50%;
    align-items: flex-start;
    justify-content: flex-end;
}

.hud-topo-centro {
    left: calc(var(--lumora-dimensoes-minimapa) + var(--lumora-espacamento-grande));
    right: calc(var(--lumora-dimensoes-minimapa) + var(--lumora-espacamento-grande));
    top: var(--lumora-espacamento-grande);
    max-width: none;
    align-items: center;
}

.hud-centro-avisos {
    left: calc(var(--lumora-dimensoes-minimapa) + var(--lumora-espacamento-grande));
    right: calc(var(--lumora-dimensoes-minimapa) + var(--lumora-espacamento-grande));
    top: var(--lumora-dimensoes-avisos-topo);
    max-width: none;
    align-items: center;
}

.hud-inferior-centro {
    left: 0;
    right: 0;
    bottom: var(--lumora-dimensoes-avisos-base);
    align-items: center;
}

.hud-superior-direita {
    right: var(--lumora-espacamento-grande);
    top: var(--lumora-espacamento-grande);
    align-items: flex-end;
}

.avisos {
    align-items: center;
    max-width: 100%;
}

.aviso {
    margin-top: var(--lumora-espacamento-minimo);
    padding: var(--lumora-espacamento-minimo) var(--lumora-espacamento-medio);
    font-size: var(--lumora-tipografia-controle);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: var(--lumora-cores-painel);
}

.aviso-informacao {
    color: var(--lumora-cores-marfim);
}

.aviso-aviso {
    color: var(--lumora-cores-ouro);
}

.aviso-erro {
    color: var(--lumora-cores-erro);
}

.lumora-estreito .linha-botoes {
    flex-direction: column;
}

.lumora-estreito .painel {
    width: 100%;
}

.lumora-estreito .atalho-nome {
    display: none;
}

.lumora-estreito .hud-inferior-esquerda {
    left: var(--lumora-espacamento-pequeno);
    width: var(--lumora-dimensoes-ferramentas);
    max-width: 55%;
}

.lumora-estreito .hud-chat {
    left: var(--lumora-espacamento-pequeno);
    width: var(--lumora-dimensoes-ferramentas);
    max-width: 55%;
}

.lumora-estreito .hud-superior-direita {
    right: var(--lumora-espacamento-pequeno);
    top: var(--lumora-espacamento-pequeno);
}

.mundo-minimapa {
    width: var(--lumora-dimensoes-minimapa);
    height: var(--lumora-dimensoes-minimapa);
    border-radius: var(--lumora-dimensoes-minimapa-raio);
    border-width: var(--lumora-bordas-destaque);
    border-color: var(--lumora-cores-ouro);
    overflow: hidden;
    background-color: var(--lumora-cores-trilho);
}

.mundo-minimapa-norte {
    position: absolute;
    top: var(--lumora-espacamento-minimo);
    left: 0;
    right: 0;
    -unity-text-align: upper-center;
    font-size: var(--lumora-tipografia-leitura);
    color: var(--lumora-cores-marfim);
    text-shadow: var(--lumora-bordas-fina) var(--lumora-bordas-fina) var(--lumora-cores-sombra);
}

.mundo-mapa {
    width: var(--lumora-dimensoes-mapa);
    height: var(--lumora-dimensoes-mapa);
    max-width: 100%;
    margin-top: var(--lumora-espacamento-pequeno);
    align-self: center;
    border-width: var(--lumora-bordas-destaque);
    border-color: var(--lumora-cores-ouro);
}
